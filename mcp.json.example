{
  "mcpServers": {
    "gitnexus": {
      "command": "gitnexus",
      "args": ["mcp"],
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    },
    "memory": {
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "fetch": {
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    "markitdown-mcp": {
      "command": "C:/Users/Asus/.cursor/.venv-markitdown/Scripts/markitdown-mcp.exe",
      "args": []
    },
    "playwright": {
      "command": "npx.cmd",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx.cmd",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "@21st-dev/magic": {
      "command": "npx.cmd",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": {
        "API_KEY": "YOUR_21ST_MAGIC_API_KEY"
      }
    },
    "stitch": {
      "command": "node",
      "args": ["C:/Users/Asus/.cursor/commands/stitch-mcp-proxy.mjs"],
      "env": {
        "STITCH_API_KEY": "YOUR_STITCH_API_KEY"
      }
    },
    "gemini": {
      "command": "npx.cmd",
      "args": ["-y", "@anzchy/mcp-server-gemini"],
      "env": {
        "GEMINI_API_KEY": "YOUR_GOOGLE_AI_STUDIO_API_KEY",
        "GOOGLE_API_KEY": "YOUR_GOOGLE_AI_STUDIO_API_KEY",
        "GEMINI_DEFAULT_MODEL": "gemini-flash-latest"
      }
    },
    "n8n-mcp": {
      "url": "https://YOUR_INSTANCE.app.n8n.cloud/mcp-server/http",
      "headers": {
        "Authorization": "Bearer YOUR_N8N_MCP_JWT"
      }
    },
    "prompts.chat": {
      "url": "https://prompts.chat/api/mcp"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "context7": {
      "command": "npx.cmd",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "iconify": {
      "command": "npx.cmd",
      "args": ["-y", "iconify-mcp-server"]
    },
    "apify": {
      "url": "https://mcp.apify.com/?tools=actors,docs,apify/rag-web-browser"
    },
    "magnific": {
      "url": "https://mcp.magnific.com"
    },
    "google-workspace": {
      "command": "node",
      "args": ["C:/Users/Asus/.cursor/commands/google-workspace-mcp-wrapper.mjs"]
    },
    "google-maps": {
      "url": "https://mapscodeassist.googleapis.com/mcp/v1"
    }
  }
}
