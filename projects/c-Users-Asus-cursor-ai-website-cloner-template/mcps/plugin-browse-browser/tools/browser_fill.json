{
  "name": "browser_fill",
  "description": "Fill an input field by ref. Clears the field first. Presses Enter after by default.",
  "arguments": {
    "type": "object",
    "properties": {
      "ref": {
        "type": "string",
        "description": "Element ref from snapshot (e.g., @0-5)"
      },
      "value": {
        "type": "string",
        "description": "Value to fill"
      },
      "pressEnter": {
        "type": "boolean",
        "description": "Whether to press Enter after filling (default: true)"
      }
    },
    "required": [
      "ref",
      "value"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "plugin": "browse",
  "marketplace": "cursor-public",
  "pluginId": "675",
  "marketplaceId": "34"
}