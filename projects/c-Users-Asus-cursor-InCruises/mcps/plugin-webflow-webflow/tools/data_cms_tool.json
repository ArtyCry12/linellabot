{
  "name": "data_cms_tool",
  "description": "Data tool - CMS tool to perform actions like get collection list, get collection details, create collection, create collection fields (static/option/reference), update collection field, delete collection field, list collection items, create collection items, update collection items, publish collection items, delete collection items, and unpublish collection items",
  "arguments": {
    "type": "object",
    "properties": {
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "description": "Label to identify this action in the response when sending multiple actions."
            },
            "create_collection": {
              "type": "object",
              "properties": {
                "siteId": {
                  "type": "string",
                  "description": "The ID of the site. DO NOT ASSUME site id. ALWAYS ask user for site id if not already provided or known. use sites_list tool to fetch all sites and then ask user to select one of them."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string",
                      "description": "Name of the collection. Each collection must have a unique name within the site."
                    },
                    "singularName": {
                      "type": "string",
                      "description": "Singular name of the collection."
                    },
                    "slug": {
                      "type": "string",
                      "description": "Slug of the collection in the site URL structure. "
                    }
                  },
                  "required": [
                    "displayName",
                    "singularName"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "siteId",
                "request"
              ],
              "additionalProperties": false,
              "description": "Create a new CMS collection in a site with specified name and schema."
            },
            "create_collection_items": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "cmsLocaleIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": [],
                      "description": "Unique identifier for the locale of the CMS Item."
                    },
                    "isArchived": {
                      "type": "boolean",
                      "default": false,
                      "description": "Indicates if the item is archived."
                    },
                    "isDraft": {
                      "type": "boolean",
                      "default": false,
                      "description": "Indicates if the item is a draft."
                    },
                    "fieldData": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "type": "object",
                            "additionalProperties": {}
                          },
                          {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "description": "Name of the field."
                              },
                              "slug": {
                                "type": "string",
                                "description": "URL structure of the Item in your site. Note: Updates to an item slug will break all links referencing the old slug."
                              }
                            },
                            "required": [
                              "name",
                              "slug"
                            ]
                          }
                        ]
                      },
                      "description": "Data of the item."
                    }
                  },
                  "required": [
                    "fieldData"
                  ],
                  "additionalProperties": false,
                  "description": "Array of items to be created."
                }
              },
              "required": [
                "collection_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Create new items in a CMS collection as drafts."
            },
            "create_collection_option_field": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier for the Field."
                    },
                    "isEditable": {
                      "type": "boolean",
                      "description": "Indicates if the field is editable."
                    },
                    "isRequired": {
                      "type": "boolean",
                      "description": "Indicates if the field is required."
                    },
                    "type": {
                      "type": "string",
                      "const": "Option",
                      "description": "Type of the field. Set this to \"Option\"."
                    },
                    "displayName": {
                      "type": "string",
                      "description": "Name of the field."
                    },
                    "helpText": {
                      "type": "string",
                      "description": "Help text for the field."
                    },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string",
                                "description": "Name of the option."
                              },
                              "id": {
                                "type": "string",
                                "description": "Unique identifier for the option."
                              }
                            },
                            "required": [
                              "name"
                            ],
                            "additionalProperties": false,
                            "description": "Array of options for the field."
                          }
                        }
                      },
                      "required": [
                        "options"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "displayName",
                    "metadata"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "collection_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Create a new option field in a CMS collection with predefined choices."
            },
            "create_collection_reference_field": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier for the Field."
                    },
                    "isEditable": {
                      "type": "boolean",
                      "description": "Indicates if the field is editable."
                    },
                    "isRequired": {
                      "type": "boolean",
                      "description": "Indicates if the field is required."
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "MultiReference",
                        "Reference"
                      ],
                      "description": "Type of the field. Choose of these appropriate field types."
                    },
                    "displayName": {
                      "type": "string",
                      "description": "Name of the field."
                    },
                    "helpText": {
                      "type": "string",
                      "description": "Help text for the field."
                    },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "collectionId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "collectionId"
                      ],
                      "additionalProperties": false,
                      "description": "ID of the referenced collection. Use this only for Reference and MultiReference fields."
                    }
                  },
                  "required": [
                    "type",
                    "displayName",
                    "metadata"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "collection_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Create a new reference field in a CMS collection that links to items in another collection."
            },
            "create_collection_static_field": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Unique identifier for the Field."
                    },
                    "isEditable": {
                      "type": "boolean",
                      "description": "Indicates if the field is editable."
                    },
                    "isRequired": {
                      "type": "boolean",
                      "description": "Indicates if the field is required."
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "Color",
                        "DateTime",
                        "Email",
                        "File",
                        "Image",
                        "Link",
                        "MultiImage",
                        "Number",
                        "Phone",
                        "PlainText",
                        "RichText",
                        "Switch",
                        "VideoLink"
                      ],
                      "description": "Type of the field. Choose of these appropriate field types."
                    },
                    "displayName": {
                      "type": "string",
                      "description": "Name of the field."
                    },
                    "helpText": {
                      "type": "string",
                      "description": "Help text for the field."
                    }
                  },
                  "required": [
                    "type",
                    "displayName"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "collection_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Create a new static field in a CMS collection (e.g., text, number, date, etc.)."
            },
            "delete_collection_field": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "field_id": {
                  "type": "string",
                  "description": "Unique identifier for the Field to delete."
                }
              },
              "required": [
                "collection_id",
                "field_id"
              ],
              "additionalProperties": false,
              "description": "Delete a custom field in a CMS collection. This endpoint does not support bulk deletion."
            },
            "delete_collection_items": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Item ID to be deleted."
                          },
                          "cmsLocaleIds": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Unique identifier for the locale of the CMS Item."
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      "description": "Array of items to be deleted."
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false,
                  "description": "Array of items to be deleted."
                }
              },
              "required": [
                "collection_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Delete existing items in a CMS collection as drafts."
            },
            "get_collection_details": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                }
              },
              "required": [
                "collection_id"
              ],
              "additionalProperties": false,
              "description": "Get detailed information about a specific CMS collection including its schema and field definitions."
            },
            "get_collection_list": {
              "type": "object",
              "properties": {
                "siteId": {
                  "$ref": "#/properties/actions/items/properties/create_collection/properties/siteId"
                }
              },
              "required": [
                "siteId"
              ],
              "additionalProperties": false,
              "description": "List all CMS collections in a site. Returns collection metadata including IDs, names, and schemas."
            },
            "list_collection_items": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "cmsLocaleId": {
                      "type": "string",
                      "description": "Unique identifier for the locale of the CMS Item."
                    },
                    "limit": {
                      "type": "number",
                      "description": "Maximum number of records to be returned (max limit: 100)"
                    },
                    "offset": {
                      "type": "number",
                      "description": "Offset used for pagination if the results have more than limit records."
                    },
                    "name": {
                      "type": "string",
                      "description": "Name of the field."
                    },
                    "slug": {
                      "type": "string",
                      "description": "URL structure of the Item in your site. Note: Updates to an item slug will break all links referencing the old slug."
                    },
                    "sortBy": {
                      "type": "string",
                      "enum": [
                        "lastPublished",
                        "name",
                        "slug"
                      ],
                      "description": "Field to sort the items by. Allowed values: lastPublished, name, slug."
                    },
                    "sortOrder": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ],
                      "description": "Order to sort the items by. Allowed values: asc, desc."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Filter and sort items in a CMS collection."
                }
              },
              "required": [
                "collection_id"
              ],
              "additionalProperties": false,
              "description": "List items in a CMS collection with optional filtering and sorting."
            },
            "publish_collection_items": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "itemIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Array of item IDs to be published."
                    }
                  },
                  "required": [
                    "itemIds"
                  ],
                  "additionalProperties": false,
                  "description": "Array of items to be published."
                }
              },
              "required": [
                "collection_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Publish existing items in a CMS collection as drafts."
            },
            "unpublish_collection_items": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Item ID to be unpublished."
                          },
                          "cmsLocaleIds": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Unique identifier for the locale of the CMS Item."
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": false
                      },
                      "description": "Array of items to be unpublished."
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false,
                  "description": "Array of items to be unpublished."
                }
              },
              "required": [
                "collection_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Unpublish live items in a CMS collection. Items are removed from the live site and reverted to draft (isDraft=true). Up to 100 items per call."
            },
            "update_collection_field": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "field_id": {
                  "type": "string",
                  "description": "Unique identifier for the Field."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "isRequired": {
                      "type": "boolean",
                      "description": "Indicates if the field is required in a collection."
                    },
                    "displayName": {
                      "type": "string",
                      "description": "Name of the field."
                    },
                    "helpText": {
                      "type": "string",
                      "description": "Help text for the field."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Request schema to update collection field metadata."
                }
              },
              "required": [
                "collection_id",
                "field_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Update properties of an existing field in a CMS collection."
            },
            "update_collection_items": {
              "type": "object",
              "properties": {
                "collection_id": {
                  "type": "string",
                  "description": "Unique identifier for the Collection."
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Unique identifier for the item."
                          },
                          "cmsLocaleId": {
                            "type": "string",
                            "description": "Unique identifier for the locale of the CMS Item."
                          },
                          "lastPublished": {
                            "type": "string",
                            "description": "Date when the item was last published."
                          },
                          "lastUpdated": {
                            "type": "string",
                            "description": "Date when the item was last updated."
                          },
                          "createdOn": {
                            "type": "string",
                            "description": "Date when the item was created."
                          },
                          "isArchived": {
                            "type": "boolean",
                            "description": "Indicates if the item is archived."
                          },
                          "isDraft": {
                            "type": "boolean",
                            "description": "Indicates if the item is a draft."
                          },
                          "fieldData": {
                            "allOf": [
                              {
                                "type": "object",
                                "additionalProperties": {}
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "description": "Name of the field."
                                  },
                                  "slug": {
                                    "type": "string",
                                    "description": "URL structure of the Item in your site. Note: Updates to an item slug will break all links referencing the old slug."
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "fieldData"
                        ],
                        "additionalProperties": false,
                        "description": "Collection item update request schema."
                      }
                    }
                  },
                  "additionalProperties": false,
                  "description": "Array of items to be updated."
                }
              },
              "required": [
                "collection_id",
                "request"
              ],
              "additionalProperties": false,
              "description": "Update existing items in a CMS collection as drafts."
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        }
      },
      "context": {
        "type": "string",
        "description": "Explain why you are calling this tool and how it fits into the user's overall goal. This parameter is used for analytics and user intent tracking. YOU MUST provide 15-25 words (count carefully). NEVER use first person ('I', 'we', 'you') - maintain third-person perspective. NEVER include sensitive information such as credentials, passwords, or personal data. Example (20 words): \"Searching across the organization's repositories to find all open issues related to performance complaints and latency issues for team prioritization.\""
      }
    },
    "required": [
      "actions",
      "context"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "plugin": "webflow",
  "marketplace": "cursor-public",
  "pluginId": "1090",
  "marketplaceId": "34"
}