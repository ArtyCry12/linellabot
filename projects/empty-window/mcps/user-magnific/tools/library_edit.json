{
  "name": "library_edit",
  "description": "Edit an owned library asset (character/product/location) by numeric `id`. Partial update: send only fields to change. Optionally replace `cover` and/or `images` (reference set). No LoRA/variants/sheet regen.",
  "arguments": {
    "type": "object",
    "properties": {
      "id": {
        "description": "Numeric library asset id (from library_create / library_list).",
        "type": "integer"
      },
      "name": {
        "description": "New unique A-Z/0-9/_/- name, max 50.",
        "type": "string"
      },
      "description": {
        "description": "New description, max 1000. Empty string clears it.",
        "type": "string"
      },
      "gender": {
        "description": "Character only.",
        "type": "string"
      },
      "productType": {
        "description": "Product only.",
        "type": "string"
      },
      "cover": {
        "description": "Replace the cover/preview image.",
        "additionalProperties": false,
        "properties": {
          "creationIdentifier": {
            "description": "Creation identifier. Exclusive with `url`.",
            "type": "string"
          },
          "url": {
            "description": "Public HTTPS URL. Exclusive with `creationIdentifier`.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "images": {
        "description": "Replace the reference image set (1-6 JPEG/PNG/WebP).",
        "items": {
          "description": "Replace the cover/preview image.",
          "additionalProperties": false,
          "properties": {
            "creationIdentifier": {
              "description": "Creation identifier. Exclusive with `url`.",
              "type": "string"
            },
            "url": {
              "description": "Public HTTPS URL. Exclusive with `creationIdentifier`.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "id"
    ]
  }
}