{
  "name": "images_upscale",
  "description": "AI upscale 2x/4x/8x/16x (Magnific, premium). creative=hallucinate detail (creativity/hdr/resemblance/engine); precision=faithful (sharpness/grain/ultraDetail). Exact pixels: `images_resize`. Aspect: `images_crop`. Defaults: scale=2x, creative.",
  "arguments": {
    "type": "object",
    "properties": {
      "creationIdentifier": {
        "description": "Image creation identifier (import uploads first).",
        "type": "string"
      },
      "scale": {
        "description": "Scale factor (default 2x).",
        "enum": [
          "2x",
          "4x",
          "8x",
          "16x"
        ],
        "type": "string"
      },
      "precision": {
        "description": "'creative' (default) or 'precision'.",
        "enum": [
          "creative",
          "precision"
        ],
        "type": "string"
      },
      "presets": {
        "description": "Creative style; default 'subtle'.",
        "enum": [
          "subtle",
          "vivid",
          "wild"
        ],
        "type": "string"
      },
      "optimised": {
        "description": "Creative \"optimized for\" preset, e.g. StandardUltra.",
        "type": "string"
      },
      "engine": {
        "description": "Creative engine; default automatic.",
        "enum": [
          "automatic",
          "magnific_illusio",
          "magnific_sharpy",
          "magnific_sparkle"
        ],
        "type": "string"
      },
      "mode": {
        "description": "Magnific ultra mode variant.",
        "enum": [
          "ultra",
          "ultra-sublime",
          "ultra-photo",
          "ultra-denoiser"
        ],
        "type": "string"
      },
      "prompt": {
        "description": "Optional guidance prompt.",
        "type": "string"
      },
      "creativity": {
        "description": "Creative; -10..10.",
        "type": "integer"
      },
      "resemblance": {
        "description": "Creative; -10..10.",
        "type": "integer"
      },
      "hdr": {
        "description": "Creative; -10..10.",
        "type": "integer"
      },
      "fractality": {
        "description": "Creative; -10..10.",
        "type": "integer"
      },
      "sharpness": {
        "description": "Precision; 0..100.",
        "type": "integer"
      },
      "grain": {
        "description": "Precision; 0..100.",
        "type": "integer"
      },
      "ultraDetail": {
        "description": "Precision; 0..100.",
        "type": "integer"
      },
      "folderReference": {
        "description": "Optional project/folder reference from `folders_list` to place results in. Omit for the default.",
        "type": "string"
      }
    },
    "required": [
      "creationIdentifier"
    ]
  }
}