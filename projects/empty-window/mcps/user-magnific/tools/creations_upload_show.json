{
  "name": "creations_upload_show",
  "description": "Inline upload widget for user-local files (image/video/audio). No-UI clients use creations_request_upload + creations_finalize_upload instead.",
  "arguments": {
    "type": "object",
    "properties": {
      "type": {
        "description": "Default auto.",
        "enum": [
          "auto",
          "image",
          "video",
          "audio"
        ],
        "type": "string"
      },
      "label": {
        "description": "Widget heading.",
        "type": "string"
      },
      "min_files": {
        "description": "Gates Continue. Default 1.",
        "minimum": 0,
        "maximum": 20,
        "type": "integer"
      },
      "max_files": {
        "description": "Default 20 (1 when multiple=false).",
        "minimum": 1,
        "maximum": 20,
        "type": "integer"
      },
      "multiple": {
        "description": "Default true for image/auto, false for video/audio.",
        "type": "boolean"
      }
    }
  }
}