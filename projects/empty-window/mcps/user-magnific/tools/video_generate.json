{
  "name": "video_generate",
  "description": "Generate video. External clients: call `video_plan` first to draft the brief and resolve model choice — skip only if the user explicitly says \"just generate\" or \"one-shot\". Pick a model with `slug` (copy it verbatim from `video_models_list`); omit `slug` for auto-select. Image refs: use an asset URL or a creation `identifier`; never `webUrl`. Limits: `video_models_list`. On UI-capable clients, after generating you MUST call `creations_show` once with all returned identifiers to render results; never stop at links.",
  "arguments": {
    "type": "object",
    "properties": {
      "video": {
        "properties": {
          "clips": {
            "items": {
              "properties": {
                "position": {
                  "description": "0-based index; defaults to array index.",
                  "type": "number"
                },
                "duration": {
                  "description": "Seconds; required when `slug` is set.",
                  "type": "number"
                },
                "slug": {
                  "description": "Model identifier copied verbatim from `video_models_list` (e.g. `bytedance-seedance-pro-2.0`); omit for auto-select. Only this field name is read — `model`/`modelSlug` are tolerated as aliases but prefer `slug`.",
                  "type": "string"
                },
                "prompt": {
                  "description": "Prompt. Check model maxLength. Exclusive with `multi_prompt`.",
                  "type": "string"
                },
                "aspectRatio": {
                  "description": "Allowed values per model.",
                  "type": "string"
                },
                "resolution": {
                  "description": "Required by some models; see catalog.",
                  "type": "string"
                },
                "keyframes": {
                  "properties": {
                    "start": {
                      "properties": {
                        "type": {
                          "description": "image.",
                          "type": "string"
                        },
                        "url": {
                          "description": "Asset URL or a creation `identifier`; never `webUrl`.",
                          "type": "string"
                        }
                      },
                      "type": "object",
                      "required": [
                        "type",
                        "url"
                      ]
                    },
                    "end": {
                      "properties": {
                        "type": {
                          "description": "image.",
                          "type": "string"
                        },
                        "url": {
                          "description": "Asset URL or a creation `identifier`; never `webUrl`.",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "video": {
                      "properties": {
                        "type": {
                          "description": "video.",
                          "type": "string"
                        },
                        "url": {
                          "description": "Asset URL or a creation `identifier`; never `webUrl`.",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                "references": {
                  "description": "Allowed types/limits per model. For Seedance 2.0 audio/lipsync, include `{type:\"audio\", url:\"asset URL or creation identifier\"}` here; this can coexist with `withSoundEffects:true` and needs a visual reference.",
                  "items": {
                    "properties": {
                      "type": {
                        "description": "Use `audio` for Seedance 2.0 audio/lipsync references.",
                        "enum": [
                          "image",
                          "video",
                          "character",
                          "product",
                          "style",
                          "color",
                          "effect",
                          "audio"
                        ],
                        "type": "string"
                      },
                      "url": {
                        "description": "Asset URL or a creation `identifier`. Required for non-color/effect refs; for Seedance 2.0 audio/lipsync put the audio URL here with type `audio`.",
                        "type": "string"
                      },
                      "custom_model_id": {
                        "description": "Custom-reference identifier.",
                        "type": "string"
                      },
                      "modifier_key": {
                        "description": "Prompt mention key, max 100 chars.",
                        "type": "string"
                      },
                      "name": {
                        "description": "Required with `custom_model_id`.",
                        "type": "string"
                      },
                      "images": {
                        "description": "Selected custom-model media IDs. Not for Kling.",
                        "items": {
                          "type": "integer"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object",
                    "required": [
                      "type"
                    ]
                  },
                  "type": "array"
                },
                "cameraMotion": {
                  "description": "Only when model lists cameraMotion values.",
                  "type": "string"
                },
                "negativePrompt": {
                  "description": "Only when model supports `negativePrompt`.",
                  "type": "string"
                },
                "audioUrl": {
                  "description": "Only for lipsync-only models whose catalog has audioConstraints without limit. Do not use for Seedance 2.0; use `references[].type=\"audio\"` instead. Exclusive with `withSoundEffects`.",
                  "type": "string"
                },
                "withSoundEffects": {
                  "description": "Only when model has soundEffects.allowed.",
                  "type": "boolean"
                },
                "multi_prompt": {
                  "description": "Only when multishot.allowed; max 6; replaces `prompt`.",
                  "items": {
                    "properties": {
                      "index": {
                        "description": "1-based shot index.",
                        "type": "number"
                      },
                      "prompt": {
                        "type": "string"
                      },
                      "duration": {
                        "description": "Shot seconds; Seedance requires it.",
                        "type": "number"
                      },
                      "cameraMotion": {
                        "type": "string"
                      }
                    },
                    "type": "object",
                    "required": [
                      "prompt"
                    ]
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "clips"
        ]
      },
      "folderReference": {
        "description": "Optional project/folder reference from `folders_list` to place results in. Omit for the default.",
        "type": "string"
      }
    },
    "required": [
      "video"
    ]
  }
}