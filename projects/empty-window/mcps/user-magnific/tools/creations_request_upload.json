{
  "name": "creations_request_upload",
  "description": "Step 1 for local/user files: get presigned PUT URL(s). Upload bytes outside MCP, then call `creations_finalize_upload`.",
  "arguments": {
    "type": "object",
    "properties": {
      "mimeType": {
        "description": "File MIME type.",
        "enum": [
          "image/jpeg",
          "image/png",
          "image/webp",
          "video/mp4",
          "video/quicktime",
          "video/webm",
          "video/x-m4v",
          "audio/wav",
          "audio/x-wav",
          "audio/mpeg",
          "audio/mp4",
          "audio/ogg",
          "audio/flac"
        ],
        "type": "string"
      },
      "count": {
        "description": "Batch count; omitted returns one upload.",
        "minimum": 1,
        "maximum": 100,
        "type": "integer"
      }
    },
    "required": [
      "mimeType"
    ]
  }
}