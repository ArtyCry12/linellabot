{
  "name": "creations_wait",
  "description": "Long-poll 1..8 creations until terminal or `timeoutSeconds` (default 25, max 25). In-progress entries get `poll_after_seconds` for the next call.",
  "arguments": {
    "type": "object",
    "properties": {
      "identifiers": {
        "description": "1..8 creation identifiers.",
        "items": {
          "description": "Creation identifier.",
          "type": "string"
        },
        "type": "array"
      },
      "timeoutSeconds": {
        "description": "Long-poll budget (default 25).",
        "minimum": 0,
        "maximum": 25,
        "type": "integer"
      }
    },
    "required": [
      "identifiers"
    ]
  }
}