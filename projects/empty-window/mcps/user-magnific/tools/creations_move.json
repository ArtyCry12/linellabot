{
  "name": "creations_move",
  "description": "Move creations into `targetFolderReference`. Identifiers from `images_generate`/`creations_search`. Foreign identifier → abort. Target folder must belong to user.",
  "arguments": {
    "type": "object",
    "properties": {
      "targetFolderReference": {
        "description": "Destination folder ref. User-owned.",
        "type": "string"
      },
      "creationIdentifiers": {
        "description": "Creation identifiers (max 200). Foreign identifier → abort.",
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "targetFolderReference",
      "creationIdentifiers"
    ]
  }
}