{
  "name": "creations_like",
  "description": "Toggle heart/favorite reaction on a user-owned creation.",
  "arguments": {
    "type": "object",
    "properties": {
      "creationIdentifier": {
        "description": "Creation identifier (from `creations_search`/`creations_get`).",
        "type": "string"
      },
      "folderReference": {
        "description": "`folderReference` from `creations_search`/`creations_get`.",
        "type": "string"
      },
      "unlike": {
        "description": "Set `true` to remove the existing heart. Default `false` (add a heart).",
        "type": "boolean"
      }
    },
    "required": [
      "creationIdentifier",
      "folderReference"
    ]
  }
}