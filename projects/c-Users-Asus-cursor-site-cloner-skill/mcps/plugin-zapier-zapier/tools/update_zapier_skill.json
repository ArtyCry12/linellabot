{
  "name": "update_zapier_skill",
  "description": "Update an existing Zapier Skill's description or content. Use when the user wants to refine a skill, fix an issue, or add new instructions.",
  "arguments": {
    "type": "object",
    "properties": {
      "name": {
        "description": "The exact name of the skill to update",
        "type": "string",
        "minLength": 1
      },
      "description": {
        "description": "Updated one-sentence description (optional)",
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "skillDefinition": {
        "description": "Updated full markdown content (optional)",
        "type": "string",
        "minLength": 1,
        "maxLength": 100000
      }
    },
    "required": [
      "name"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "plugin": "zapier",
  "marketplace": "cursor-public",
  "pluginId": "762",
  "marketplaceId": "34"
}