{
  "name": "send-batch-emails",
  "description": "**Purpose:** Send up to 100 transactional emails in one API call. Each item has the same fields as send-email (to, subject, text, from, etc.).\n\n**NOT for:** Sending one email (use send-email) or the same content to a segment (use create-broadcast + send-broadcast).\n\n**When to use:** User wants to send many individual emails in bulk (e.g. 50 password resets, 100 receipts). Not for one-to-many broadcasts.",
  "arguments": {
    "type": "object",
    "properties": {
      "emails": {
        "minItems": 1,
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "to": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "description": "Array of recipient email addresses (1-50 recipients)"
            },
            "subject": {
              "type": "string",
              "description": "Email subject line"
            },
            "text": {
              "type": "string",
              "description": "Plain text email content"
            },
            "html": {
              "description": "HTML email content",
              "type": "string"
            },
            "from": {
              "description": "Sender email address. Falls back to the configured default sender if not provided.",
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "replyTo": {
              "description": "Reply-to email addresses",
              "type": "array",
              "items": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "cc": {
              "description": "CC email addresses",
              "type": "array",
              "items": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "bcc": {
              "description": "BCC email addresses",
              "type": "array",
              "items": {
                "type": "string",
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "scheduledAt": {
              "description": "Optional schedule time. Uses natural language (e.g., 'tomorrow at 10am') or ISO 8601.",
              "type": "string"
            },
            "tags": {
              "description": "Custom tags for tracking/analytics",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Tag name (key)"
                  },
                  "value": {
                    "type": "string",
                    "description": "Tag value"
                  }
                },
                "required": [
                  "name",
                  "value"
                ]
              }
            },
            "topicId": {
              "description": "Topic ID for subscription-based sending",
              "type": "string"
            }
          },
          "required": [
            "to",
            "subject",
            "text"
          ]
        },
        "description": "Array of email objects to send (1-100 emails)"
      }
    },
    "required": [
      "emails"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "plugin": "resend",
  "marketplace": "cursor-public",
  "pluginId": "5188",
  "marketplaceId": "34"
}