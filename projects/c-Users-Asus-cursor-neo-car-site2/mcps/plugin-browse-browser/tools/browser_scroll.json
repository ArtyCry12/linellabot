{
  "name": "browser_scroll",
  "description": "Scroll the page at given coordinates.",
  "arguments": {
    "type": "object",
    "properties": {
      "x": {
        "type": "number",
        "description": "X coordinate to scroll at"
      },
      "y": {
        "type": "number",
        "description": "Y coordinate to scroll at"
      },
      "deltaX": {
        "type": "number",
        "description": "Horizontal scroll amount (default: 0)"
      },
      "deltaY": {
        "type": "number",
        "description": "Vertical scroll amount (default: 500)"
      }
    },
    "required": [
      "x",
      "y"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "plugin": "browse",
  "marketplace": "cursor-public",
  "pluginId": "675",
  "marketplaceId": "34"
}