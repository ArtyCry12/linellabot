{
  "name": "browser_get",
  "description": "Get page info: url, title, text, html, value, or box. For text/html/value/box, provide a CSS selector.",
  "arguments": {
    "type": "object",
    "properties": {
      "what": {
        "type": "string",
        "enum": [
          "url",
          "title",
          "text",
          "html",
          "value",
          "box"
        ],
        "description": "What to get"
      },
      "selector": {
        "type": "string",
        "description": "CSS selector (required for text, html, value, box)"
      }
    },
    "required": [
      "what"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "plugin": "browse",
  "marketplace": "cursor-public",
  "pluginId": "675",
  "marketplaceId": "34"
}