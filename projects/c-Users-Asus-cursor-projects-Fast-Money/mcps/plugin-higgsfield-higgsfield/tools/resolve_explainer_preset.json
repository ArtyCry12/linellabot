{
  "name": "resolve_explainer_preset",
  "description": "Resolve an explainer video style preset (from get_youtube_explainer_presets) into a style reference media_id: the backend imports the preset's style image into the user's media storage. Pass the returned media_id as the style reference image in generation calls for every scene of the explainer.",
  "arguments": {
    "type": "object",
    "properties": {
      "preset_id": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "description": "Preset id from get_youtube_explainer_presets."
      }
    },
    "required": [
      "preset_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "preset_id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "media_id": {
        "type": "string",
        "description": "Imported style image — use as the style reference in generations."
      }
    },
    "required": [
      "preset_id",
      "name",
      "media_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "plugin": "higgsfield",
  "marketplace": "cursor-public",
  "pluginId": "5420454",
  "marketplaceId": "34"
}