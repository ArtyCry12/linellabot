{
  "name": "video_analysis_jobs",
  "description": "List the user's video analyses in the current workspace, newest first. Paginate by passing the previous response's cursor.",
  "arguments": {
    "type": "object",
    "properties": {
      "size": {
        "description": "Page size.",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "cursor": {
        "description": "Pagination cursor — unix timestamp of created_at from the previous page (advances backwards in time). Omit for the first page.",
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "video_input_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "youtube_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "in_progress",
                "completed",
                "failed"
              ]
            },
            "fail_reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "video_s3_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scenes": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {}
                },
                {
                  "type": "null"
                }
              ]
            },
            "created_at": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "video_input_id",
            "youtube_url",
            "status",
            "fail_reason",
            "video_s3_url",
            "scenes",
            "created_at",
            "updated_at"
          ],
          "additionalProperties": false
        }
      },
      "total_count": {
        "type": "number"
      },
      "cursor": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "items",
      "total_count",
      "cursor"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "plugin": "higgsfield",
  "marketplace": "cursor-public",
  "pluginId": "5420454",
  "marketplaceId": "34"
}