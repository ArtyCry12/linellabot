                "pending",
                "waiting",
                "queued",
                "in_progress",
                "ip_detect",
                "completed",
                "failed",
                "canceled",
                "nsfw",
                "ip_detected"
              ]
            },
            "model": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "properties": {
                "prompt": {
                  "default": "",
                  "type": "string"
                },
                "aspect_ratio": {
