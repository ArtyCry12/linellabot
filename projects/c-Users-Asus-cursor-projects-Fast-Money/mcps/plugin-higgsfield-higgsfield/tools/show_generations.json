                            },
                            "type": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": {}
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reference_images": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
