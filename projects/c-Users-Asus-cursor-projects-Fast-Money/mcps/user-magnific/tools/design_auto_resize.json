{
  "name": "design_auto_resize",
  "description": "Create resized design pages from an image. Use directly when ratios/social formats are known; otherwise show `design_auto_resize_show`.",
  "arguments": {
    "type": "object",
    "properties": {
      "creationIdentifier": {
        "description": "Source image identifier.",
        "type": "string"
      },
      "aspectRatios": {
        "description": "Unique target ratios.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "name": {
        "description": "2-6 word name.",
        "type": "string"
      },
      "textLayers": {
        "description": "Default true.",
        "type": "boolean"
      },
      "imageLayers": {
        "description": "Default true.",
        "type": "boolean"
      },
      "numLayers": {
        "description": "2-8.",
        "minimum": 2,
        "maximum": 8,
        "type": "integer"
      },
      "multipage": {
        "description": "Default true; false fans out.",
        "type": "boolean"
      }
    },
    "required": [
      "creationIdentifier",
      "aspectRatios"
    ]
  }
}