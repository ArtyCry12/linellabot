{
  "name": "library_list",
  "description": "Lean library catalog for agent reasoning: references (characters, styles, elements, locations), color palettes, agents and contexts. Visual picker uses library://.",
  "arguments": {
    "type": "object",
    "properties": {
      "scope": {
        "description": "all (default)|projects|organization.",
        "enum": [
          "all",
          "projects",
          "organization"
        ],
        "type": "string"
      },
      "type": {
        "description": "character|style|element|locations|color|agent|context.",
        "enum": [
          "character",
          "style",
          "element",
          "locations",
          "color",
          "agent",
          "context"
        ],
        "type": "string"
      },
      "page": {
        "description": "Default 1.",
        "type": "integer"
      },
      "perPage": {
        "description": "Default/max 50.",
        "type": "integer"
      },
      "search": {
        "description": "Filter by name/description.",
        "type": "string"
      }
    }
  }
}