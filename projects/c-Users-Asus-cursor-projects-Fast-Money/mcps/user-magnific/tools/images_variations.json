{
  "name": "images_variations",
  "description": "Generate image-variation grid. Modes: angles|demographics|expressions|age|storyboard|custom. Defaults: angles, 3x3, 1:1, 4k.",
  "arguments": {
    "type": "object",
    "properties": {
      "creationIdentifier": {
        "description": "Source image identifier.",
        "type": "string"
      },
      "variationMode": {
        "description": "Default 'angles'.",
        "enum": [
          "angles",
          "demographics",
          "expressions",
          "age",
          "storyboard",
          "custom"
        ],
        "type": "string"
      },
      "prompt": {
        "description": "Required for custom; used for storyboard.",
        "type": "string"
      },
      "gridRows": {
        "description": "Default 3.",
        "minimum": 1,
        "maximum": 4,
        "type": "integer"
      },
      "gridCols": {
        "description": "Default 3. rows*cols <= 9.",
        "minimum": 1,
        "maximum": 4,
        "type": "integer"
      },
      "aspectRatio": {
        "description": "'1:1' default.",
        "enum": [
          "1:1",
          "21:9",
          "16:9",
          "9:16",
          "4:3",
          "4:5",
          "5:4",
          "3:4",
          "3:2",
          "2:3"
        ],
        "type": "string"
      },
      "resolution": {
        "description": "'2k' or '4k' (default).",
        "enum": [
          "2k",
          "4k"
        ],
        "type": "string"
      },
      "selectedAngles": {
        "description": "Angles mode labels, ideally one per tile.",
        "maxItems": 9,
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "selectedEthnicities": {
        "description": "Demographic labels.",
        "maxItems": 9,
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "selectedGenders": {
        "description": "Demographics mode genders.",
        "maxItems": 9,
        "items": {
          "enum": [
            "male",
            "female"
          ],
          "type": "string"
        },
        "type": "array"
      },
      "folderReference": {
        "description": "Optional project/folder reference from `folders_list` to place results in. Omit for the default.",
        "type": "string"
      }
    },
    "required": [
      "creationIdentifier"
    ]
  }
}