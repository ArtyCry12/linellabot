{
  "name": "images_skin_enhancer",
  "description": "AI skin enhancer. faithful preserves identity; creative reinterprets; flexible uses presets. Defaults: faithful, sharpen=0, smartGrain=0.",
  "arguments": {
    "type": "object",
    "properties": {
      "creationIdentifier": {
        "description": "Image creation identifier (import uploads first).",
        "type": "string"
      },
      "version": {
        "description": "Default 'faithful'.",
        "enum": [
          "faithful",
          "creative",
          "flexible"
        ],
        "type": "string"
      },
      "sharpen": {
        "description": "0-100; default 0.",
        "minimum": 0,
        "maximum": 100,
        "type": "integer"
      },
      "smartGrain": {
        "description": "0-100; default 0.",
        "minimum": 0,
        "maximum": 100,
        "type": "integer"
      },
      "skinDetail": {
        "description": "faithful only.",
        "minimum": 0,
        "maximum": 100,
        "type": "integer"
      },
      "optimizedFor": {
        "description": "flexible only.",
        "enum": [
          "enhance_skin",
          "enhance_everything",
          "improve_lighting",
          "transform_to_real",
          "no_make_up"
        ],
        "type": "string"
      },
      "folderReference": {
        "description": "Optional project/folder reference from `folders_list` to place results in. Omit for the default.",
        "type": "string"
      }
    },
    "required": [
      "creationIdentifier"
    ]
  }
}