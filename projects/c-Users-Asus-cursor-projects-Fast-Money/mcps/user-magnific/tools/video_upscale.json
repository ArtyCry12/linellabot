{
  "name": "video_upscale",
  "description": "Upscale video via Topaz or Magnific. Pass `creationIdentifier` or Freepik `videoUrl`. Params: `video_upscale_models_list`. Then call `creations_show`.",
  "arguments": {
    "type": "object",
    "properties": {
      "creationIdentifier": {
        "description": "Completed owned video identifier. Required without `videoUrl`.",
        "type": "string"
      },
      "videoUrl": {
        "description": "Freepik video URL. Required without `creationIdentifier`.",
        "type": "string"
      },
      "mode": {
        "description": "See `video_upscale_models_list`.",
        "enum": [
          "topaz",
          "magnific",
          "magnific_precision"
        ],
        "type": "string"
      },
      "upscaleFactor": {
        "description": "Topaz only, required: 1-8.",
        "type": "number"
      },
      "targetFps": {
        "description": "Topaz only, required: 0-60 FPS.",
        "type": "number"
      },
      "targetResolution": {
        "description": "Magnific/Precision required: width 640-3840.",
        "type": "number"
      },
      "focus": {
        "description": "Topaz only, required: 0-1.",
        "type": "number"
      },
      "sharpen": {
        "description": "Topaz: 0-1 required. Magnific: 0-100.",
        "type": "number"
      },
      "enhancementModel": {
        "description": "Topaz only, required.",
        "enum": [
          "proteus",
          "artemis",
          "nyx",
          "rhea",
          "gaia",
          "colorize",
          "dione",
          "theia",
          "iris",
          "themis",
          "starlightFast2",
          "astra2",
          "starlightPrecise25"
        ],
        "type": "string"
      },
      "frameInterpolation": {
        "description": "Topaz only, required.",
        "enum": [
          "apollo",
          "chronos"
        ],
        "type": "string"
      },
      "creativity": {
        "description": "Magnific Creative only: 0-100.",
        "type": "number"
      },
      "magnificResolution": {
        "description": "Magnific preset.",
        "enum": [
          "720p",
          "1k",
          "2k",
          "4k"
        ],
        "type": "string"
      },
      "premiumQuality": {
        "description": "Magnific Creative only.",
        "type": "boolean"
      },
      "fpsBoost": {
        "description": "Magnific/Precision only.",
        "type": "boolean"
      },
      "smartGrain": {
        "description": "Magnific/Precision: 0-100.",
        "type": "number"
      },
      "flavor": {
        "description": "Magnific Creative only.",
        "enum": [
          "vivid",
          "natural"
        ],
        "type": "string"
      },
      "turbo": {
        "description": "Magnific Creative only.",
        "type": "boolean"
      },
      "preview": {
        "description": "Magnific/Precision preview.",
        "type": "boolean"
      },
      "strength": {
        "description": "Precision 0-100.",
        "type": "number"
      },
      "folderReference": {
        "description": "Optional project/folder reference from `folders_list` to place results in. Omit for the default.",
        "type": "string"
      }
    },
    "required": [
      "mode"
    ]
  }
}