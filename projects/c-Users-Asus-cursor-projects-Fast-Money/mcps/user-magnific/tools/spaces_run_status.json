{
  "name": "spaces_run_status",
  "description": "Poll `spaces_run`. `timeoutSeconds` long-polls up to 25s. In-progress returns `poll_after_seconds`; terminal call `creations_show`.",
  "arguments": {
    "type": "object",
    "properties": {
      "workflowRunIdentifier": {
        "description": "Run identifier from `spaces_run`.",
        "type": "string"
      },
      "timeoutSeconds": {
        "description": "0 snapshot, 1-25 long-poll.",
        "minimum": 0,
        "maximum": 25,
        "type": "integer"
      }
    },
    "required": [
      "workflowRunIdentifier"
    ]
  }
}