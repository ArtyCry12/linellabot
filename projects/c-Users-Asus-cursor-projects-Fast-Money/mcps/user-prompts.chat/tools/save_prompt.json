{
  "name": "save_prompt",
  "description": "Save a new prompt to your prompts.chat account. Requires API key authentication. Prompts are private by default unless configured otherwise in settings.",
  "arguments": {
    "type": "object",
    "properties": {
      "title": {
        "description": "Title of the prompt",
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "content": {
        "description": "The prompt content. Can include variables like ${variable} or ${variable:default}",
        "type": "string",
        "minLength": 1
      },
      "description": {
        "description": "Optional description of the prompt",
        "type": "string",
        "maxLength": 500
      },
      "tags": {
        "description": "Optional array of tag names (will be created if they don't exist)",
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "category": {
        "description": "Optional category slug",
        "type": "string"
      },
      "isPrivate": {
        "description": "Whether the prompt is private (default: uses your account setting)",
        "type": "boolean"
      },
      "type": {
        "description": "Prompt type (default: TEXT)",
        "type": "string",
        "enum": [
          "TEXT",
          "STRUCTURED",
          "IMAGE",
          "VIDEO",
          "AUDIO"
        ]
      },
      "structuredFormat": {
        "description": "Format for structured prompts",
        "type": "string",
        "enum": [
          "JSON",
          "YAML"
        ]
      }
    },
    "required": [
      "title",
      "content"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}