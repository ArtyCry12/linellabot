{
  "name": "data_sitemap_tool",
  "description": "Data tool - Manage sitemap indexing status for CMS collection items and static pages. Read and update whether pages and collection items appear in a site's generated sitemap. All endpoints are under the /beta namespace. Folder pages, collection template pages, and utility pages are not supported for page endpoints.",
  "arguments": {
    "type": "object",
    "properties": {
      "actions": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "bulk_update_items_sitemap_status": {
                  "type": "object",
                  "properties": {
                    "collection_id": {
                      "type": "string",
                      "description": "Unique identifier for the CMS collection."
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Collection item ID."
                          },
                          "includeInSitemap": {
                            "type": "boolean",
                            "description": "Whether to include the item in the sitemap."
                          },
                          "cmsLocaleId": {
                            "type": "string",
                            "description": "Target a specific locale. Omit for primary locale."
                          }
                        },
                        "required": [
                          "id",
                          "includeInSitemap"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100,
                      "description": "Array of items to update (max 100). Each must have an id and includeInSitemap."
                    }
                  },
                  "required": [
                    "collection_id",
                    "items"
                  ],
                  "additionalProperties": false,
                  "description": "Bulk update sitemap indexing status for up to 100 collection items (staged). Publish the site afterward for changes to go live."
                }
              },
              "required": [
                "label",
                "bulk_update_items_sitemap_status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "bulk_update_pages_sitemap_status": {
                  "type": "object",
                  "properties": {
                    "site_id": {
                      "type": "string",
                      "description": "Unique identifier for the Webflow site. Use list_sites to discover available site IDs."
                    },
                    "localeId": {
                      "type": "string",
                      "description": "Applies to all pages in the batch."
                    },
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Page ID."
                          },
                          "includeInSitemap": {
                            "type": "boolean",
                            "description": "Whether to include the page in the sitemap."
                          }
                        },
                        "required": [
                          "id",
                          "includeInSitemap"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100,
                      "description": "Array of pages to update (max 100). Each must have an id and includeInSitemap."
                    }
                  },
                  "required": [
                    "site_id",
                    "pages"
                  ],
                  "additionalProperties": false,
                  "description": "Bulk update sitemap indexing status for up to 100 pages. Does not work for folder pages, collection template pages, or utility pages."
                }
              },
              "required": [
                "label",
                "bulk_update_pages_sitemap_status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "get_item_sitemap_status": {
                  "type": "object",
                  "properties": {
                    "collection_id": {
                      "type": "string",
                      "description": "Unique identifier for the CMS collection."
                    },
                    "item_id": {
                      "type": "string",
                      "description": "Unique identifier for the collection item."
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "staged",
                        "live"
                      ],
                      "description": "Whether to get staged or live (published) status. Defaults to \"staged\"."
                    },
                    "cmsLocaleId": {
                      "type": "string",
                      "description": "Filter by CMS locale ID."
                    }
                  },
                  "required": [
                    "collection_id",
                    "item_id"
                  ],
                  "additionalProperties": false,
                  "description": "Get sitemap indexing status for a single collection item."
                }
              },
              "required": [
                "label",
                "get_item_sitemap_status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "get_page_sitemap_status": {
                  "type": "object",
                  "properties": {
                    "page_id": {
                      "type": "string",
                      "description": "Unique identifier for the page."
                    },
                    "localeId": {
                      "type": "string",
                      "description": "Filter by locale ID."
                    }
                  },
                  "required": [
                    "page_id"
                  ],
                  "additionalProperties": false,
                  "description": "Get sitemap indexing status for a single static page. Does not work for folder pages, collection template pages, or utility pages."
                }
              },
              "required": [
                "label",
                "get_page_sitemap_status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "list_items_sitemap_status": {
                  "type": "object",
                  "properties": {
                    "collection_id": {
                      "type": "string",
                      "description": "Unique identifier for the CMS collection."
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "staged",
                        "live"
                      ],
                      "description": "Whether to list staged or live (published) items. Defaults to \"staged\"."
                    },
                    "cmsLocaleId": {
                      "type": "string",
                      "description": "Filter by CMS locale ID."
                    },
                    "limit": {
                      "type": "number",
                      "description": "Maximum number of items to return (max 100)."
                    },
                    "offset": {
                      "type": "number",
                      "description": "Number of items to skip for pagination."
                    }
                  },
                  "required": [
                    "collection_id"
                  ],
                  "additionalProperties": false,
                  "description": "List sitemap indexing status for all items in a collection. Returns each item's ID, slug, name, and includeInSitemap flag with pagination."
                }
              },
              "required": [
                "label",
                "list_items_sitemap_status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "list_pages_sitemap_status": {
                  "type": "object",
                  "properties": {
                    "site_id": {
                      "type": "string",
                      "description": "Unique identifier for the Webflow site. Use list_sites to discover available site IDs."
                    },
                    "localeId": {
                      "type": "string",
                      "description": "Return locale-specific indexing status."
                    },
                    "limit": {
                      "type": "number",
                      "description": "Maximum number of pages to return (max 100)."
                    },
                    "offset": {
                      "type": "number",
                      "description": "Number of pages to skip for pagination."
                    }
                  },
                  "required": [
                    "site_id"
                  ],
                  "additionalProperties": false,
                  "description": "List sitemap indexing status for all supported pages on a site. Excludes folder pages, collection template pages, and utility pages."
                }
              },
              "required": [
                "label",
                "list_pages_sitemap_status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "update_item_sitemap_status": {
                  "type": "object",
                  "properties": {
                    "collection_id": {
                      "type": "string",
                      "description": "Unique identifier for the CMS collection."
                    },
                    "item_id": {
                      "type": "string",
                      "description": "Unique identifier for the collection item."
                    },
                    "includeInSitemap": {
                      "type": "boolean",
                      "description": "Whether to include the item in the sitemap."
                    },
                    "cmsLocaleId": {
                      "type": "string",
                      "description": "Target a specific locale. Omit for primary locale."
                    }
                  },
                  "required": [
                    "collection_id",
                    "item_id",
                    "includeInSitemap"
                  ],
                  "additionalProperties": false,
                  "description": "Update sitemap indexing status for a single collection item (staged). Publish the site afterward for changes to go live."
                }
              },
              "required": [
                "label",
                "update_item_sitemap_status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "update_page_sitemap_status": {
                  "type": "object",
                  "properties": {
                    "page_id": {
                      "type": "string",
                      "description": "Unique identifier for the page."
                    },
                    "includeInSitemap": {
                      "type": "boolean",
                      "description": "Whether to include the page in the sitemap."
                    },
                    "localeId": {
                      "type": "string",
                      "description": "Target a specific locale's setting."
                    }
                  },
                  "required": [
                    "page_id",
                    "includeInSitemap"
                  ],
                  "additionalProperties": false,
                  "description": "Update sitemap indexing status for a single static page. Does not work for folder pages, collection template pages, or utility pages."
                }
              },
              "required": [
                "label",
                "update_page_sitemap_status"
              ],
              "additionalProperties": false
            }
          ]
        },
        "minItems": 1,
        "description": "Actions to execute sequentially. Each array item must include label and exactly one action property."
      },
      "context": {
        "type": "string",
        "description": "Explain why this tool is being called and how it fits the user's goal, in 15-25 words, third person (no 'I'/'we'/'you'). Used for analytics only. Never include credentials or personal data."
      }
    },
    "required": [
      "actions",
      "context"
    ],
    "$defs": {
      "label": {
        "type": "string",
        "description": "Echoed in the response; does not select which action runs."
      }
    }
  },
  "plugin": "webflow",
  "marketplace": "cursor-public",
  "pluginId": "1090",
  "marketplaceId": "34"
}