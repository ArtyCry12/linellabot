{
  "name": "data_element_builder",
  "description": "Data Tool - Element builder to create elements on a page via the public-mcp headless surface.",
  "arguments": {
    "type": "object",
    "properties": {
      "siteId": {
        "type": "string",
        "description": "Webflow site ID. Use list_sites to discover site IDs."
      },
      "pageId": {
        "type": "string",
        "description": "Any valid page id that exists in the site"
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "build_label": {
              "type": "string",
              "description": "A label to identify this build action in the results."
            },
            "parent_element_id": {
              "type": "object",
              "properties": {
                "component": {
                  "type": "string",
                  "description": "The component id of the element to perform action on."
                },
                "element": {
                  "type": "string",
                  "description": "The element id of the element to perform action on."
                },
                "prop": {
                  "type": "string",
                  "description": "Optional text prop id. Set when the parent is an element inside a TextPropElement or RichTextPropElement of a component instance."
                }
              },
              "required": [
                "component",
                "element"
              ],
              "additionalProperties": false,
              "description": "The id of the parent element to create element on, you can find it from id field on element. e.g id:{component:123,element:456}."
            },
            "creation_position": {
              "type": "string",
              "enum": [
                "append",
                "prepend",
                "before",
                "after"
              ],
              "description": "The position to create element on. append/prepend insert as child of the parent element. before/after insert as sibling adjacent to the target element."
            },
            "element_schema": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "Container",
                    "Section",
                    "DivBlock",
                    "Heading",
                    "TextBlock",
                    "Paragraph",
                    "Button",
                    "TextLink",
                    "LinkBlock",
                    "Image",
                    "RichText",
                    "CodeBlock",
                    "Blockquote",
                    "HtmlEmbed",
                    "Video",
                    "YouTubeVideo",
                    "Lightbox",
                    "Form",
                    "FormBlockLabel",
                    "FormTextInput",
                    "FormTextarea",
                    "FormCheckboxInput",
                    "FormRadioInput",
                    "FormSelect",
                    "FormFileUploadWrapper",
                    "FormButton",
                    "Tabs",
                    "Slider",
                    "CMSCollection",
                    "PageSlot",
                    "ComponentSlot",
                    "Dropdown",
                    "DOM",
                    "BY_CUSTOM_TAG"
                  ],
                  "description": "The type of element to create. Use DOM for a generic DOM element (requires set_dom_config). Use BY_CUSTOM_TAG to create any element by arbitrary HTML tag with optional atomic settings (requires custom_tag)."
                },
                "set_style": {
                  "type": "object",
                  "properties": {
                    "style_names": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "The style names to set on the element."
                    }
                  },
                  "required": [
                    "style_names"
                  ],
                  "additionalProperties": false,
                  "description": "Set style on the element. it will remove all other styles on the element. and set only the styles passed in style_names."
                },
                "set_text": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "description": "The text to set on the element."
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "description": "Set text on the element. only valid for text block, paragraph, heading, button, text link, link block."
                },
                "set_link": {
                  "type": "object",
                  "properties": {
                    "link_type": {
                      "type": "string",
                      "enum": [
                        "url",
                        "file",
                        "page",
                        "element",
                        "email",
                        "phone"
                      ],
                      "description": "The type of link to set on the element."
                    },
                    "link": {
                      "type": "string",
                      "description": "The link to set on the element."
                    }
                  },
                  "required": [
                    "link_type",
                    "link"
                  ],
                  "additionalProperties": false,
                  "description": "Set link on the element. only valid for button, text link, link block."
                },
                "set_heading_level": {
                  "type": "object",
                  "properties": {
                    "heading_level": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 6,
                      "description": "The heading level to set on the element."
                    }
                  },
                  "required": [
                    "heading_level"
                  ],
                  "additionalProperties": false,
                  "description": "Set heading level on the element. only valid for heading."
                },
                "set_image_asset": {
                  "type": "object",
                  "properties": {
                    "image_asset_id": {
                      "type": "string",
                      "description": "The image asset id to set on the element."
                    },
                    "alt_text": {
                      "type": "string",
                      "description": "The alt text to set on the image. if not provided it will inherit from the image asset."
                    }
                  },
                  "required": [
                    "image_asset_id"
                  ],
                  "additionalProperties": false,
                  "description": "Set image asset on the element. only valid for image."
                },
                "set_dom_config": {
                  "type": "object",
                  "properties": {
                    "dom_tag": {
                      "type": "string",
                      "description": "The tag of the DOM element to create. for example span, code, etc."
                    }
                  },
                  "required": [
                    "dom_tag"
                  ],
                  "additionalProperties": false,
                  "description": "Set DOM config on the element. only valid for DOM element."
                },
                "custom_tag": {
                  "type": "string",
                  "description": "HTML tag name for the new element (e.g. 'div', 'span', 'p', 'h1'). Required when type is BY_CUSTOM_TAG."
                },
                "set_attributes": {
                  "type": "object",
                  "properties": {
                    "attributes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "The name of the attribute to set."
                          },
                          "value": {
                            "type": "string",
                            "description": "The value of the attribute to set."
                          }
                        },
                        "required": [
                          "name",
                          "value"
                        ],
                        "additionalProperties": false
                      },
                      "description": "The attributes to set on the element."
                    }
                  },
                  "required": [
                    "attributes"
                  ],
                  "additionalProperties": false,
                  "description": "Set attributes on the element."
                },
                "settings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "description": "The setting key to write (e.g. \"domId\", \"altText\", \"href\", \"visibility\", \"attributes\"). Use get_settings to discover keys."
                      },
                      "clear": {
                        "type": "boolean",
                        "const": true,
                        "description": "Set true to reset the setting to its default (writes null)."
                      },
                      "binding": {
                        "$ref": "#/$defs/binding"
                      },
                      "static_text": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "description": "Static string value. For keys producing string / textContent / id / altText / image (asset ID)."
                          },
                          "rich_text_inner_text": {
                            "type": "string",
                            "description": "Static rich-text inner content. Maps to { innerText }."
                          }
                        },
                        "additionalProperties": false,
                        "description": "Static text value (string or rich text)."
                      },
                      "static_number": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "number",
                            "description": "Static number value."
                          }
                        },
                        "required": [
                          "value"
                        ],
                        "additionalProperties": false,
                        "description": "Static number value for numeric settings."
                      },
                      "static_boolean": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "boolean",
                            "description": "Static boolean value."
                          }
                        },
                        "required": [
                          "value"
                        ],
                        "additionalProperties": false,
                        "description": "Static boolean value for boolean settings (e.g. \"visibility\")."
                      },
                      "static_link": {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "enum": [
                              "url",
                              "page",
                              "pageSection",
                              "email",
                              "phone",
                              "file",
                              "collectionPage"
                            ],
                            "description": "Link mode."
                          },
                          "to": {
                            "type": "string",
                            "description": "Link target. For url/email/phone: literal value. For page: pageId. For file: assetId. For collectionPage: pageSlug. Not used for pageSection — use to_element_id instead."
                          },
                          "to_element_id": {
                            "type": "object",
                            "properties": {
                              "component": {
                                "type": "string",
                                "description": "Pass element.id.component verbatim — do not invent or shorten it."
                              },
                              "element": {
                                "type": "string",
                                "description": "Pass element.id.element verbatim — do not invent or shorten it."
                              }
                            },
                            "required": [
                              "component",
                              "element"
                            ],
                            "additionalProperties": false,
                            "description": "Target element id (component + element) for the pageSection link. Only used when mode is \"pageSection\"."
                          },
                          "open_in_new_tab": {
                            "type": "boolean",
                            "description": "Whether the link opens in a new tab."
                          },
                          "email_subject": {
                            "type": "string",
                            "description": "Email subject. Only used when mode is \"email\"."
                          },
                          "rel": {
                            "type": "string",
                            "description": "The rel attribute for the link."
                          }
                        },
                        "additionalProperties": false,
                        "description": "Static link value (for link-shaped settings)."
                      },
                      "static_video": {
                        "type": "object",
                        "properties": {
                          "src": {
                            "type": "string",
                            "description": "Video source URL."
                          },
                          "title": {
                            "type": "string",
                            "description": "Video title."
                          }
                        },
                        "additionalProperties": false,
                        "description": "Static video value (for video-shaped settings)."
                      },
                      "static_json": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "description": "JSON-encoded value (object or array), e.g. '{\"key\":\"value\"}' or '[1,2,3]'."
                          }
                        },
                        "required": [
                          "value"
                        ],
                        "additionalProperties": false,
                        "description": "Static JSON value (for JSON-shaped settings)."
                      },
                      "attributes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name_static": {
                              "type": "string",
                              "description": "Static attribute name."
                            },
                            "name_binding": {
                              "$ref": "#/$defs/binding",
                              "description": "Bind the attribute name to a typed data source (DOM elements only). See BindableSourceInputSchema for variants."
                            },
                            "value_static": {
                              "type": "string",
                              "description": "Static attribute value."
                            },
                            "value_binding": {
                              "$ref": "#/$defs/binding",
                              "description": "Bind the attribute value to a typed data source. See BindableSourceInputSchema for variants."
                            }
                          },
                          "additionalProperties": false,
                          "description": "One attribute entry. Exactly one of name_static / name_binding must be set; exactly one of value_static / value_binding must be set."
                        },
                        "description": "Only valid when key is \"attributes\". Replaces the element's full attribute list (pass an empty array to remove all)."
                      }
                    },
                    "required": [
                      "key"
                    ],
                    "additionalProperties": false,
                    "description": "One setting write. Exactly one of clear / binding / static_text / static_number / static_boolean / static_link / static_video / attributes must be provided."
                  },
                  "description": "Settings to apply atomically on element creation (e.g. domId, altText, visibility). Same format as set_settings. If any setting is invalid the element is not created. Only applies to DOM type elements."
                },
                "children": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  },
                  "description": "Child element schemas. Each child must use the same element_schema shape, including type and optional setup fields like set_style, set_text, settings, and children. Children may include their own children at any depth. The child item schema is passthrough because JSON Schema cannot represent unbounded recursion reliably in MCP descriptors."
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "description": "ElementSchema - element schema of element to create. To build nested trees, pass children[]; each child uses the same element_schema shape and can nest to any depth."
            },
            "return_element_info": {
              "type": "boolean",
              "description": "Whether to return full element info for the created element. Defaults to false."
            },
            "scope_component_id": {
              "type": "string",
              "description": "Optional component id. When set, the parent_element_id lookup walks this component's tree instead of the page tree — required to create elements inside a component definition."
            }
          },
          "required": [
            "build_label",
            "parent_element_id",
            "creation_position",
            "element_schema"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "description": "Element creation actions executed sequentially. Each item creates one element at the requested position."
      },
      "context": {
        "type": "string",
        "description": "Explain why this tool is being called and how it fits the user's goal, in 15-25 words, third person (no 'I'/'we'/'you'). Used for analytics only. Never include credentials or personal data."
      }
    },
    "required": [
      "siteId",
      "pageId",
      "actions",
      "context"
    ],
    "$defs": {
      "binding": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string",
                "const": "prop",
                "description": "Bind to a component prop on the current component instance."
              },
              "prop_id": {
                "type": "string",
                "minLength": 1,
                "description": "ID of the component prop on the current component instance. Discover with the component props tool's get_component_instance_props action."
              }
            },
            "required": [
              "source_type",
              "prop_id"
            ],
            "additionalProperties": false,
            "description": "Bind to a component prop."
          },
          {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string",
                "const": "cms",
                "description": "Bind to a CMS collection field."
              },
              "collection_id": {
                "type": "string",
                "minLength": 1,
                "description": "CMS collection ID containing the field. Discover with data_cms_tool > list_collections."
              },
              "field_id": {
                "type": "string",
                "minLength": 1,
                "description": "Field ID within the CMS collection. Discover with data_cms_tool > get_collection."
              }
            },
            "required": [
              "source_type",
              "collection_id",
              "field_id"
            ],
            "additionalProperties": false,
            "description": "Bind to a CMS field."
          },
          {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string",
                "const": "page",
                "description": "Bind to a page-level field."
              },
              "field_key": {
                "type": "string",
                "minLength": 1,
                "description": "Page-level field key (e.g. 'title', 'slug'). Discover with element tool > get_bindable_sources."
              }
            },
            "required": [
              "source_type",
              "field_key"
            ],
            "additionalProperties": false,
            "description": "Bind to a page field."
          },
          {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string",
                "const": "locale",
                "description": "Bind to a locale-level field."
              },
              "field_key": {
                "type": "string",
                "minLength": 1,
                "description": "Locale-level field key. Discover with element tool > get_bindable_sources."
              }
            },
            "required": [
              "source_type",
              "field_key"
            ],
            "additionalProperties": false,
            "description": "Bind to a locale field."
          },
          {
            "type": "object",
            "properties": {
              "source_type": {
                "type": "string",
                "const": "localeItem",
                "description": "Bind to a locale-item field."
              },
              "field_key": {
                "type": "string",
                "minLength": 1,
                "description": "Locale-item field key. Discover with element tool > get_bindable_sources."
              }
            },
            "required": [
              "source_type",
              "field_key"
            ],
            "additionalProperties": false,
            "description": "Bind to a locale-item field."
          }
        ],
        "description": "Bind the setting to a typed data source (used instead of a static_* group). See BindableSourceInputSchema for variants."
      }
    }
  },
  "plugin": "webflow",
  "marketplace": "cursor-public",
  "pluginId": "1090",
  "marketplaceId": "34"
}