{
  "name": "data_component_props_tool",
  "description": "Data tool - Component props tool to manage prop definitions and set or reset prop values on component instances.",
  "arguments": {
    "type": "object",
    "properties": {
      "siteId": {
        "type": "string",
        "description": "Webflow site ID. Use list_sites to discover site IDs."
      },
      "pageId": {
        "type": "string",
        "description": "Any valid page id exists in the site"
      },
      "actions": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "create_prop": {
                  "type": "object",
                  "properties": {
                    "component_id": {
                      "type": "string"
                    },
                    "props": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "textContent",
                              "string",
                              "richText",
                              "image",
                              "link",
                              "video",
                              "number",
                              "boolean",
                              "id",
                              "altText"
                            ]
                          },
                          "name": {
                            "type": "string",
                            "description": "Display name."
                          },
                          "group": {
                            "type": "string"
                          },
                          "tooltip": {
                            "type": "string"
                          },
                          "default_text": {
                            "$ref": "#/$defs/default_text"
                          },
                          "default_number": {
                            "$ref": "#/$defs/default_number"
                          },
                          "default_boolean": {
                            "$ref": "#/$defs/default_boolean"
                          },
                          "default_link": {
                            "$ref": "#/$defs/default_link"
                          },
                          "default_video": {
                            "$ref": "#/$defs/default_video"
                          }
                        },
                        "required": [
                          "type",
                          "name"
                        ],
                        "additionalProperties": false,
                        "description": "Per-type settings go in the matching default_* group; image/id/altText/textContent props take no default group beyond `default_text` when applicable."
                      },
                      "description": "Props to create."
                    }
                  },
                  "required": [
                    "component_id",
                    "props"
                  ],
                  "additionalProperties": false,
                  "description": "Create prop definitions on a component."
                }
              },
              "required": [
                "label",
                "create_prop"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "update_prop": {
                  "type": "object",
                  "properties": {
                    "component_id": {
                      "type": "string"
                    },
                    "props": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "prop_id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "group": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Pass null to clear."
                          },
                          "tooltip": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Pass null to clear."
                          },
                          "clear_default_value": {
                            "type": "boolean",
                            "description": "Clears the default value entirely. Cannot be combined with any default_* field — the default_* value silently wins."
                          },
                          "default_text": {
                            "$ref": "#/$defs/default_text"
                          },
                          "default_number": {
                            "$ref": "#/$defs/default_number"
                          },
                          "default_boolean": {
                            "$ref": "#/$defs/default_boolean"
                          },
                          "default_link": {
                            "$ref": "#/$defs/default_link"
                          },
                          "default_video": {
                            "$ref": "#/$defs/default_video"
                          }
                        },
                        "required": [
                          "prop_id"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "component_id",
                    "props"
                  ],
                  "additionalProperties": false,
                  "description": "Update prop definitions on a component; omitted fields stay the same."
                }
              },
              "required": [
                "label",
                "update_prop"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "remove_prop": {
                  "type": "object",
                  "properties": {
                    "component_id": {
                      "type": "string"
                    },
                    "prop_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "component_id",
                    "prop_ids"
                  ],
                  "additionalProperties": false,
                  "description": "Remove prop definitions from a component; each is removed independently and per-prop errors are aggregated."
                }
              },
              "required": [
                "label",
                "remove_prop"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "get_component_instance_props": {
                  "type": "object",
                  "properties": {
                    "element_id": {
                      "type": "object",
                      "properties": {
                        "component": {
                          "type": "string"
                        },
                        "element": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "component",
                        "element"
                      ],
                      "additionalProperties": false,
                      "description": "Element id of the component instance."
                    },
                    "resolved_value": {
                      "type": "boolean",
                      "description": "Whether to resolve bindings to concrete values instead of binding references."
                    },
                    "scope_component_id": {
                      "$ref": "#/$defs/scope_component_id"
                    }
                  },
                  "required": [
                    "element_id"
                  ],
                  "additionalProperties": false,
                  "description": "Get prop definitions and current values for a component instance element, including instances inside component definitions."
                }
              },
              "required": [
                "label",
                "get_component_instance_props"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "set_component_instance_prop_values": {
                  "type": "object",
                  "properties": {
                    "element_id": {
                      "type": "object",
                      "properties": {
                        "component": {
                          "type": "string",
                          "description": "Pass element.id.component verbatim — do not invent or shorten it."
                        },
                        "element": {
                          "type": "string",
                          "description": "Pass element.id.element verbatim — do not invent or shorten it."
                        }
                      },
                      "required": [
                        "component",
                        "element"
                      ],
                      "additionalProperties": false,
                      "description": "The `id` object of a Designer element — two fields, not a single string. Copy it verbatim from the tool result that returned the element."
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "prop_id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "string",
                              "number",
                              "boolean",
                              "null",
                              "link",
                              "video",
                              "richText",
                              "bindable"
                            ]
                          },
                          "string_value": {
                            "type": "string",
                            "description": "Required when type is \"string\"."
                          },
                          "number_value": {
                            "type": "number",
                            "description": "Required when type is \"number\"."
                          },
                          "boolean_value": {
                            "type": "boolean",
                            "description": "Required when type is \"boolean\"."
                          },
                          "link_mode": {
                            "type": "string",
                            "enum": [
                              "url",
                              "page",
                              "pageSection",
                              "email",
                              "phone",
                              "file",
                              "collectionPage"
                            ],
                            "description": "Required when type is \"link\"."
                          },
                          "link_to": {
                            "type": "string",
                            "description": "Literal value for url/email/phone; pageId for page; assetId for file; pageSlug for collectionPage; elementId for pageSection."
                          },
                          "link_to_component_id": {
                            "type": "string",
                            "description": "Component id of the target element; only used when link_mode is \"pageSection\"."
                          },
                          "link_open_in_new_tab": {
                            "type": "boolean"
                          },
                          "link_email_subject": {
                            "type": "string",
                            "description": "Only used when link_mode is email."
                          },
                          "link_rel": {
                            "type": "string"
                          },
                          "video_src": {
                            "type": "string",
                            "description": "Source URL. Required when type is \"video\"."
                          },
                          "video_title": {
                            "type": "string"
                          },
                          "binding_source_type": {
                            "type": "string",
                            "enum": [
                              "prop",
                              "cms",
                              "page",
                              "locale",
                              "localeItem"
                            ],
                            "description": "Required when type is \"bindable\"."
                          },
                          "binding_prop_id": {
                            "type": "string",
                            "description": "Required when binding_source_type is \"prop\"."
                          },
                          "binding_collection_id": {
                            "type": "string",
                            "description": "Required when binding_source_type is \"cms\"."
                          },
                          "binding_field_id": {
                            "type": "string",
                            "description": "Required when binding_source_type is \"cms\"."
                          },
                          "binding_field_key": {
                            "type": "string",
                            "description": "Required when binding_source_type is \"page\", \"locale\", or \"localeItem\"."
                          },
                          "rich_text_inner_text": {
                            "type": "string",
                            "description": "Rich-text inner content. Required when type is \"richText\"."
                          }
                        },
                        "required": [
                          "prop_id",
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "scope_component_id": {
                      "$ref": "#/$defs/scope_component_id"
                    }
                  },
                  "required": [
                    "element_id",
                    "values"
                  ],
                  "additionalProperties": false,
                  "description": "Set prop values on a component instance element, including instances inside component definitions. Bindings: `cms` needs a CMS context (collection template page or Collection List); `locale` needs secondary locales."
                }
              },
              "required": [
                "label",
                "set_component_instance_prop_values"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "reset_all_props_value": {
                  "type": "object",
                  "properties": {
                    "element_id": {
                      "type": "object",
                      "properties": {
                        "component": {
                          "type": "string"
                        },
                        "element": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "component",
                        "element"
                      ],
                      "additionalProperties": false,
                      "description": "Element id of the component instance to reset."
                    },
                    "scope_component_id": {
                      "$ref": "#/$defs/scope_component_id"
                    }
                  },
                  "required": [
                    "element_id"
                  ],
                  "additionalProperties": false,
                  "description": "Reset all prop values on a component instance element to their defaults, including instances inside component definitions."
                }
              },
              "required": [
                "label",
                "reset_all_props_value"
              ],
              "additionalProperties": false
            }
          ]
        },
        "minItems": 1,
        "description": "Actions to execute sequentially. Each array item must include label and exactly one action property."
      },
      "context": {
        "type": "string",
        "description": "Explain why this tool is being called and how it fits the user's goal, in 15-25 words, third person (no 'I'/'we'/'you'). Used for analytics only. Never include credentials or personal data."
      }
    },
    "required": [
      "siteId",
      "pageId",
      "actions",
      "context"
    ],
    "$defs": {
      "label": {
        "type": "string",
        "description": "Echoed in the response; does not select which action runs."
      },
      "default_text": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Default string value."
          },
          "rich_text_inner_text": {
            "type": "string",
            "description": "Default rich-text inner content."
          },
          "multiline": {
            "type": "boolean",
            "description": "Whether the text is multiline."
          }
        },
        "additionalProperties": false
      },
      "default_number": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "description": "Default number value."
          },
          "min": {
            "type": [
              "number",
              "null"
            ],
            "description": "Minimum allowed value."
          },
          "max": {
            "type": [
              "number",
              "null"
            ],
            "description": "Maximum allowed value."
          },
          "decimals": {
            "type": [
              "number",
              "null"
            ],
            "description": "Allowed decimal places."
          }
        },
        "additionalProperties": false
      },
      "default_boolean": {
        "type": "object",
        "properties": {
          "value": {
            "type": "boolean",
            "description": "Default boolean value."
          },
          "true_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Label shown when true."
          },
          "false_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Label shown when false."
          }
        },
        "additionalProperties": false
      },
      "default_link": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "url",
              "email",
              "phone"
            ]
          },
          "to": {
            "type": "string",
            "description": "Link target value."
          },
          "open_in_new_tab": {
            "type": "boolean"
          },
          "email_subject": {
            "type": "string",
            "description": "Only for email links."
          },
          "rel": {
            "type": "string",
            "description": "Anchor rel attribute."
          }
        },
        "additionalProperties": false
      },
      "default_video": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "description": "Video source URL."
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "scope_component_id": {
        "type": "string",
        "description": "Id of the component definition the element lives inside. When set, lookup walks that component's tree instead of the page; if omitted, the page is searched first, then the element id's component portion."
      }
    }
  },
  "plugin": "webflow",
  "marketplace": "cursor-public",
  "pluginId": "1090",
  "marketplaceId": "34"
}