                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/request"
                          },
                          "description": "Items to unpublish."
                        }
                      },
                      "required": [
                        "items"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "collection_id",
                    "request"
                  ],
                  "additionalProperties": false,
                  "description": "Unpublish up to 100 live CMS items per call: removes them from the live site and reverts them to draft (isDraft=true)."
                }
