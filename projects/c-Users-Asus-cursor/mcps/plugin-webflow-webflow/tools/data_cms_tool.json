    "$defs": {
      "label": {
        "type": "string",
        "description": "Echoed in the response; does not select which action runs."
      },
      "collection_id": {
        "type": "string",
        "description": "The collection ID. Use get_collection_list to discover collection IDs."
      },
      "id": {
        "type": "string",
        "description": "The field ID."
      },
      "isEditable": {
        "type": "boolean",
        "description": "Whether the field is editable."
      },
      "isRequired": {
        "type": "boolean",
        "description": "Whether the field is required."
      },
      "displayName": {
        "type": "string",
        "description": "Name of the field."
      },
      "helpText": {
        "type": "string",
        "description": "Help text for the field."
      },
      "siteId": {
        "type": "string",
        "description": "Webflow site ID. Use list_sites to discover site IDs."
      },
      "request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The item ID."
          },
          "cmsLocaleIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Locale IDs of the CMS item."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "name": {
        "type": "string",
        "description": "Display name for the CMS item."
      },
      "slug": {
        "type": "string",
        "description": "URL slug, unique within the collection. Changing it breaks all links referencing the old slug."
      }
