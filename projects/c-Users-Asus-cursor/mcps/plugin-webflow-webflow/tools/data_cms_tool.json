                            "maxLength": 64,
                            "description": "Group display name; 1-64 characters, unique within the collection ignoring case."
                          },
                          "fieldIds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "description": "A groupable collection field ID."
                            },
                            "description": "Ordered field IDs in this group. Each field ID can appear in at most one group; omit or pass an empty array for a group with no fields."
                          },
                          "description": {
                            "type": "string",
                            "maxLength": 256,
                            "description": "Optional group description (max 256 characters)."
