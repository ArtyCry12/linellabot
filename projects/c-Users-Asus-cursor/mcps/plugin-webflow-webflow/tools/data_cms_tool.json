                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "collection_id",
                    "request"
                  ],
                  "additionalProperties": false,
                  "description": "Create an option field with predefined choices in a CMS collection."
                }
              },
              "required": [
                "label",
                "create_collection_option_field"
