{
  "name": "data_webhook_tool",
  "description": "Data tool - Webhook tool to perform actions like list webhooks, create webhooks, get webhook details, and delete webhooks for a Webflow site.",
  "arguments": {
    "type": "object",
    "properties": {
      "actions": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "create_webhook": {
                  "type": "object",
                  "properties": {
                    "site_id": {
                      "type": "string",
                      "description": "The site's unique ID, used to create a webhook for this site."
                    },
                    "trigger_type": {
                      "type": "string",
                      "enum": [
                        "form_submission",
                        "site_publish",
                        "page_created",
                        "page_metadata_updated",
                        "page_deleted",
                        "ecomm_new_order",
                        "ecomm_order_changed",
                        "ecomm_inventory_changed",
                        "user_account_added",
                        "user_account_updated",
                        "user_account_deleted",
                        "collection_item_created",
                        "collection_item_changed",
                        "collection_item_deleted",
                        "collection_item_published",
                        "collection_item_unpublished",
                        "comment_created"
                      ],
                      "description": "The type of event that triggers the webhook. Choose from 17 supported trigger types."
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "The URL that will receive the webhook POST request when the event is triggered."
                    },
                    "filter": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Exact Webflow form name to receive notifications for."
                        }
                      },
                      "additionalProperties": false,
                      "description": "Optional. Use only when trigger_type is 'form_submission' to limit delivery to a specific form; omit for all other trigger types."
                    }
                  },
                  "required": [
                    "site_id",
                    "trigger_type",
                    "url"
                  ],
                  "additionalProperties": false,
                  "description": "Create a new webhook for a site. Limit of 75 registrations per trigger type, per site."
                }
              },
              "required": [
                "label",
                "create_webhook"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "delete_webhook": {
                  "type": "object",
                  "properties": {
                    "webhook_id": {
                      "type": "string",
                      "description": "The webhook's unique ID, used to identify which webhook to remove."
                    }
                  },
                  "required": [
                    "webhook_id"
                  ],
                  "additionalProperties": false,
                  "description": "Remove a webhook registration."
                }
              },
              "required": [
                "label",
                "delete_webhook"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "get_webhook": {
                  "type": "object",
                  "properties": {
                    "webhook_id": {
                      "type": "string",
                      "description": "The webhook's unique ID, used to retrieve its details."
                    }
                  },
                  "required": [
                    "webhook_id"
                  ],
                  "additionalProperties": false,
                  "description": "Get detailed information about a specific webhook including its trigger type, URL, and last triggered date."
                }
              },
              "required": [
                "label",
                "get_webhook"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "list_webhooks": {
                  "type": "object",
                  "properties": {
                    "site_id": {
                      "type": "string",
                      "description": "The site's unique ID, used to list its registered webhooks."
                    }
                  },
                  "required": [
                    "site_id"
                  ],
                  "additionalProperties": false,
                  "description": "List all App-created webhooks registered for a given site. Returns webhook details including trigger type, URL, and creation date."
                }
              },
              "required": [
                "label",
                "list_webhooks"
              ],
              "additionalProperties": false
            }
          ]
        },
        "minItems": 1,
        "description": "Actions to execute sequentially. Each array item must include label and exactly one action property."
      },
      "context": {
        "type": "string",
        "description": "Explain why this tool is being called and how it fits the user's goal, in 15-25 words, third person (no 'I'/'we'/'you'). Used for analytics only. Never include credentials or personal data."
      }
    },
    "required": [
      "actions",
      "context"
    ],
    "$defs": {
      "label": {
        "type": "string",
        "description": "Echoed in the response; does not select which action runs."
      }
    }
  },
  "plugin": "webflow",
  "marketplace": "cursor-public",
  "pluginId": "1090",
  "marketplaceId": "34"
}