{
  "name": "data_component_tool",
  "description": "Data tool - Component tool to manage component definitions and instances: create, query, transform, insert, unlink.",
  "arguments": {
    "type": "object",
    "properties": {
      "siteId": {
        "type": "string",
        "description": "Webflow site ID. Use list_sites to discover site IDs."
      },
      "pageId": {
        "type": "string",
        "description": "Any valid page id exists in the site"
      },
      "actions": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "get_all_components": {
                  "type": "object",
                  "properties": {
                    "options": {
                      "$ref": "#/$defs/options"
                    }
                  },
                  "additionalProperties": false,
                  "description": "Get all components in the site."
                }
              },
              "required": [
                "label",
                "get_all_components"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "get_component": {
                  "type": "object",
                  "properties": {
                    "component_id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string"
                    },
                    "options": {
                      "$ref": "#/$defs/options"
                    }
                  },
                  "additionalProperties": false,
                  "description": "Get a component by component_id, or by name (optionally narrowed by group)."
                }
              },
              "required": [
                "label",
                "get_component"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "query_components": {
                  "type": "object",
                  "properties": {
                    "queries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "description": "Identifies this query in the results."
                          },
                          "keywords": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Keywords matched case-insensitively as substrings against component name, group, and description; all must match (AND)."
                          },
                          "hasProps": {
                            "type": "boolean",
                            "description": "True: only components with props; false: only components without props."
                          },
                          "propsFilter": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "type": {
                                "$ref": "#/$defs/type"
                              },
                              "name": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "group": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "tooltip": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            },
                            "additionalProperties": false,
                            "description": "Only components with at least one prop matching these criteria."
                          },
                          "resultOptions": {
                            "$ref": "#/$defs/options"
                          },
                          "isLibrary": {
                            "type": "boolean",
                            "description": "True: only library components (imported from an installed library); false: exclude them."
                          },
                          "isCodeComponent": {
                            "type": "boolean",
                            "description": "True: only code components (DevLink, Site AI, Library AI); false: exclude them."
                          },
                          "limit": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 200,
                            "description": "Max results for this query (default 50)."
                          }
                        },
                        "required": [
                          "label",
                          "keywords"
                        ],
                        "additionalProperties": false
                      },
                      "description": "Labelled queries executed in one call."
                    }
                  },
                  "required": [
                    "queries"
                  ],
                  "additionalProperties": false,
                  "description": "Query components by keywords, prop characteristics, and more."
                }
              },
              "required": [
                "label",
                "query_components"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "get_parent_component": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "object",
                      "properties": {
                        "component": {
                          "type": "string"
                        },
                        "element": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "component",
                        "element"
                      ],
                      "additionalProperties": false,
                      "description": "Element id to look up."
                    },
                    "scope_component_id": {
                      "$ref": "#/$defs/scope_component_id"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false,
                  "description": "Get the component containing an element, including elements inside component definitions. Returns { found: null } for page-level elements."
                }
              },
              "required": [
                "label",
                "get_parent_component"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "create_blank_component": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string",
                      "description": "Group (folder) to place the component in."
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "description": "Create a blank component with no root element."
                }
              },
              "required": [
                "label",
                "create_blank_component"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "duplicate_component": {
                  "type": "object",
                  "properties": {
                    "source_component_id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "source_component_id",
                    "name"
                  ],
                  "additionalProperties": false,
                  "description": "Duplicate a component under a new name."
                }
              },
              "required": [
                "label",
                "duplicate_component"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "transform_element_to_component": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "object",
                      "properties": {
                        "component": {
                          "type": "string"
                        },
                        "element": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "component",
                        "element"
                      ],
                      "additionalProperties": false,
                      "description": "Element id to convert."
                    },
                    "name": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "replace": {
                      "type": "boolean",
                      "description": "Whether to replace the source element with an instance of the new component.",
                      "default": true
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": false,
                  "description": "Transform an element into a component."
                }
              },
              "required": [
                "label",
                "transform_element_to_component"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "set_component_metadata": {
                  "type": "object",
                  "properties": {
                    "component_id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "component_id"
                  ],
                  "additionalProperties": false,
                  "description": "Update a component's name, group, and/or description."
                }
              },
              "required": [
                "label",
                "set_component_metadata"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "unregister_component": {
                  "type": "object",
                  "properties": {
                    "component_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "component_id"
                  ],
                  "additionalProperties": false,
                  "description": "Unregister a component. DANGEROUS ACTION — affects all existing instances."
                }
              },
              "required": [
                "label",
                "unregister_component"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "insert_component_instance": {
                  "type": "object",
                  "properties": {
                    "parent_element_id": {
                      "type": "object",
                      "properties": {
                        "component": {
                          "type": "string"
                        },
                        "element": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "component",
                        "element"
                      ],
                      "additionalProperties": false,
                      "description": "Element to insert under or beside."
                    },
                    "component_id": {
                      "type": "string"
                    },
                    "creation_position": {
                      "type": "string",
                      "enum": [
                        "append",
                        "prepend",
                        "before",
                        "after"
                      ],
                      "description": "append/prepend insert as child; before/after insert as sibling."
                    },
                    "scope_component_id": {
                      "$ref": "#/$defs/scope_component_id"
                    }
                  },
                  "required": [
                    "parent_element_id",
                    "component_id",
                    "creation_position"
                  ],
                  "additionalProperties": false,
                  "description": "Insert a component instance on the active page, including under parents nested inside component definitions."
                }
              },
              "required": [
                "label",
                "insert_component_instance"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "unlink_component_instance": {
                  "type": "object",
                  "properties": {
                    "component_instance_id": {
                      "type": "object",
                      "properties": {
                        "component": {
                          "type": "string"
                        },
                        "element": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "component",
                        "element"
                      ],
                      "additionalProperties": false
                    },
                    "scope_component_id": {
                      "$ref": "#/$defs/scope_component_id"
                    }
                  },
                  "required": [
                    "component_instance_id"
                  ],
                  "additionalProperties": false,
                  "description": "Unlink a component instance into editable elements. Works on instances inside component definitions but not library or code components."
                }
              },
              "required": [
                "label",
                "unlink_component_instance"
              ],
              "additionalProperties": false
            }
          ]
        },
        "minItems": 1,
        "description": "Actions to execute sequentially. Each array item must include label and exactly one action property."
      },
      "context": {
        "type": "string",
        "description": "Explain why this tool is being called and how it fits the user's goal, in 15-25 words, third person (no 'I'/'we'/'you'). Used for analytics only. Never include credentials or personal data."
      }
    },
    "required": [
      "siteId",
      "pageId",
      "actions",
      "context"
    ],
    "$defs": {
      "label": {
        "type": "string",
        "description": "Echoed in the response; does not select which action runs."
      },
      "options": {
        "type": "object",
        "properties": {
          "includeProps": {
            "type": "boolean",
            "description": "Include prop definitions."
          },
          "includeInstanceCount": {
            "type": "boolean",
            "description": "Include the component's instance count."
          },
          "includeVariants": {
            "type": "boolean",
            "description": "Include all variant definitions."
          },
          "includeVariant": {
            "type": "string",
            "description": "Variant ID to include; 'base' for the base variant."
          },
          "includeSelectedVariant": {
            "type": "boolean",
            "description": "Include the currently selected variant."
          },
          "filterProps": {
            "type": "object",
            "properties": {
              "id": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "$ref": "#/$defs/type"
              },
              "name": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "group": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tooltip": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false,
            "description": "Filter included props. Fields are ANDed; values within a field are ORed."
          }
        },
        "additionalProperties": false,
        "description": "What to include in the response."
      },
      "type": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "textContent",
            "string",
            "richText",
            "link",
            "image",
            "video",
            "number",
            "boolean",
            "variant",
            "slot",
            "id",
            "altText",
            "booleanFilter",
            "visibility",
            "filter",
            "sort",
            "selectedItems"
          ]
        }
      },
      "scope_component_id": {
        "type": "string",
        "description": "Id of the component definition the element lives inside. When set, lookup walks that component's tree instead of the page; if omitted, the page is searched first, then the element id's component portion."
      }
    }
  },
  "plugin": "webflow",
  "marketplace": "cursor-public",
  "pluginId": "1090",
  "marketplaceId": "34"
}