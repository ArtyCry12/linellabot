    "$defs": {
      "label": {
        "type": "string",
        "description": "Echoed in the response; does not select which action runs."
      },
      "value": {
        "type": "object",
        "properties": {
          "static_value": {
            "type": "number"
          },
          "existing_variable_id": {
            "type": "string",
            "minLength": 1
          },
          "custom_value": {
            "type": "string",
            "description": "An arbitrary CSS expression string. Use when the value doesn't fit standard typed formats."
          }
        },
        "additionalProperties": false
      },
      "variable_collection_id": {
        "type": "string",
        "description": "The id of the variable collection containing the variable"
      },
      "value2": {
        "type": "object",
        "properties": {
          "static_value": {
            "type": "string",
            "minLength": 1
          },
          "existing_variable_id": {
            "type": "string",
            "minLength": 1
          },
          "custom_value": {
            "type": "string",
            "description": "An arbitrary CSS expression string (e.g. 'color-mix(in srgb, red 50%, blue)'). Use when the value doesn't fit standard typed formats."
          }
        },
        "additionalProperties": false
      },
      "value3": {
        "type": "object",
        "properties": {
          "static_value": {
            "type": "string",
            "minLength": 1
          },
          "existing_variable_id": {
            "type": "string",
            "minLength": 1
          },
          "custom_value": {
            "type": "string",
            "description": "An arbitrary CSS expression string. Use when the value doesn't fit standard typed formats."
          }
        },
        "additionalProperties": false
      },
      "value4": {
        "type": "object",
        "properties": {
          "static_value": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "px",
                  "em",
                  "rem",
                  "vh",
                  "vw",
                  "dvh",
                  "dvw",
                  "lvh",
                  "lvw",
                  "svh",
                  "svw",
                  "vmax",
                  "vmin",
                  "ch"
                ]
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          "existing_variable_id": {
            "type": "string",
            "minLength": 1
          },
          "custom_value": {
            "type": "string",
            "description": "An arbitrary CSS expression string (e.g. 'calc(100vh - 60px)'). Use when the value doesn't fit standard typed formats."
          }
        },
