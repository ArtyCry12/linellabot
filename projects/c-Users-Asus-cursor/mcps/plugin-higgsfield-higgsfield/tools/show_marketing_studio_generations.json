{
  "name": "show_marketing_studio_generations",
  "description": "Browse past completed Marketing Studio generations only. Returns Marketing Studio video and ad/image generations with {id, type, status, model, params, results}. Use show_generations for non-Marketing Studio image/video history.",
  "arguments": {
    "type": "object",
    "properties": {
      "cursor": {
        "description": "Pass next_cursor from previous response to get the next page",
        "type": "number"
      },
      "size": {
        "default": 24,
        "description": "Number of results per page",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "description": "Array of Marketing Studio generations. Absent on error.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "audio",
                "3d"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "waiting",
                "queued",
                "in_progress",
                "ip_detect",
                "completed",
                "failed",
                "canceled",
                "nsfw",
                "ip_detected"
              ]
            },
            "model": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "properties": {
                "prompt": {
                  "default": "",
                  "type": "string"
                },
                "aspect_ratio": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "duration": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "voice": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string"
                            }
                          },
                          "additionalProperties": {}
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reference_images": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "properties": {},
                            "additionalProperties": {}
                          }
                        ]
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "input_images": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "medias": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": {
                            "type": "string"
                          },
                          "data": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "type": {
                                "type": "string"
                              },
                              "url": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "image": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "soul_id": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {},
                          "additionalProperties": {}
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "custom_reference_id": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {},
                          "additionalProperties": {}
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "soul_reference": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "soul_id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "preview_url": {
                          "type": "string"
                        },
                        "thumbnail_url": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "soul_id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "presetMeta": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "prompt"
              ],
              "additionalProperties": {}
            },
            "results": {
              "type": "object",
              "properties": {
                "rawUrl": {
                  "type": "string"
                },
                "minUrl": {
                  "type": "string"
                },
                "thumbnailUrl": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "vtt": {
                  "type": "string"
                },
                "waveformUrl": {
                  "type": "string"
                },
                "durationSec": {
                  "type": "number"
                },
                "autosprite": {
                  "type": "object",
                  "properties": {
                    "atlasUrl": {
                      "type": "string"
                    },
                    "audioUrl": {
                      "type": "string"
                    },
                    "frameWidth": {
                      "type": "number"
                    },
                    "frameHeight": {
                      "type": "number"
                    },
                    "frameCount": {
                      "type": "number"
                    },
                    "columns": {
                      "type": "number"
                    },
                    "spritesheetId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "rawUrl"
              ],
              "additionalProperties": false
            },
            "createdAt": {
              "type": "number"
            },
            "batch_id": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "status",
            "model",
            "params"
          ],
          "additionalProperties": false
        }
      },
      "next_cursor": {
        "description": "Pass as cursor to get next page. Null if no more results.",
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "description": "Error message if the list could not be fetched.",
        "type": "string"
      },
      "request_id": {
        "description": "MCP server HTTP request ID for support/debugging. If present, show it to the user.",
        "type": "string"
      },
      "upgrade_url": {
        "description": "Upgrade URL. If present, you MUST show this exact upgrade link to the user so they can upgrade to continue working.",
        "type": "string"
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "plugin": "higgsfield",
  "marketplace": "cursor-public",
  "pluginId": "5420454",
  "marketplaceId": "34"
}