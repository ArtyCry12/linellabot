{
  "name": "show_medias",
  "description": "List your uploaded media files by type. Returns media IDs, URLs, and creation timestamps. Pass media IDs as value in the medias array of generation tools. Paginated: if next_cursor is not null, pass it as cursor to get the next page.",
  "arguments": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "image",
          "video",
          "audio"
        ],
        "description": "Media type to list"
      },
      "cursor": {
        "description": "Pass next_cursor from previous response to get next page",
        "type": "number"
      },
      "size": {
        "default": 24,
        "description": "Number of results per page",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "type"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "description": "Array of uploaded media files. Absent on error.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "image",
                "video",
                "audio"
              ]
            },
            "url": {
              "type": "string"
            },
            "created_at": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "type",
            "url",
            "created_at"
          ],
          "additionalProperties": false
        }
      },
      "next_cursor": {
        "description": "Pass as cursor to get next page. Null if no more results.",
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "type": "string"
      },
      "request_id": {
        "description": "MCP server HTTP request ID for support/debugging. If present, show it to the user.",
        "type": "string"
      },
      "upgrade_url": {
        "description": "Upgrade URL. If present, you MUST show this exact upgrade link to the user so they can upgrade to continue working.",
        "type": "string"
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "plugin": "higgsfield",
  "marketplace": "cursor-public",
  "pluginId": "5420454",
  "marketplaceId": "34"
}