{
  "name": "shorts_studio_list_sessions",
  "description": "List the caller's past Shorts Studio sessions (newest first) to find a session_id to poll with shorts_studio_status.",
  "arguments": {
    "type": "object",
    "properties": {
      "size": {
        "description": "Page size (default 20).",
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      },
      "cursor": {
        "description": "created_at cursor from a prior response.",
        "type": "number"
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "in_progress",
                "completed"
              ]
            },
            "source_video_id": {
              "type": "string"
            },
            "resolution": {
              "type": "string"
            },
            "job_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "status",
            "source_video_id",
            "resolution",
            "job_ids"
          ],
          "additionalProperties": false
        }
      },
      "has_more": {
        "type": "boolean"
      },
      "cursor": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "items",
      "has_more",
      "cursor"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "plugin": "higgsfield",
  "marketplace": "cursor-public",
  "pluginId": "5420454",
  "marketplaceId": "34"
}