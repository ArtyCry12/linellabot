{
  "name": "upscale_video",
  "description": "Upscale and enhance an existing video. Use this when the user asks to upscale, enhance, sharpen, denoise, restore, or convert a video to higher resolution. This tool does not use prompt or count, and does not support cost preflight. Choose a provider: 'bytedance' (preset-based, target 1080p/2K/4K — you MUST pass the source video width/height in pixels and may set fps to 24/30/60) or 'topaz' (Topaz Video, aspect-ratio based, target 1080p/2160p — no source dimensions needed).",
  "arguments": {
    "type": "object",
    "properties": {
      "params": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "bytedance",
                "description": "Upscale via ByteDance (preset-based)."
              },
              "video_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "Source video UUID. Confirmed uploaded video media_id or completed video job_id."
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Source video width in pixels."
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Source video height in pixels."
              },
              "fps": {
                "default": 24,
                "description": "Output frames per second. Allowed values: 24, 30, 60. fps above 30 doubles the cost.",
                "anyOf": [
                  {
                    "type": "number",
                    "const": 24
                  },
                  {
                    "type": "number",
                    "const": 30
                  },
                  {
                    "type": "number",
                    "const": 60
                  }
                ]
              },
              "resolution": {
                "default": "2k",
                "description": "Target output resolution.",
                "type": "string",
                "enum": [
                  "1080p",
                  "2k",
                  "4k"
                ]
              },
              "preset": {
                "default": "common",
                "description": "Upscale preset matching the source content type.",
                "type": "string",
                "enum": [
                  "common",
                  "aigc",
                  "short_series",
                  "ugc",
                  "old_film"
                ]
              }
            },
            "required": [
              "provider",
              "video_id",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "const": "topaz",
                "description": "Upscale via Topaz Video (aspect-ratio based)."
              },
              "video_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "Source video UUID. Confirmed uploaded video media_id or completed video job_id."
              },
              "aspect_ratio": {
                "default": "auto",
                "description": "Output aspect ratio. Use auto to preserve the closest source-video ratio.",
                "type": "string",
                "enum": [
                  "auto",
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16"
                ]
              },
              "resolution": {
                "default": "1080p",
                "description": "Output resolution. Use 2160p for 4K upscale.",
                "type": "string",
                "enum": [
                  "1080p",
                  "2160p"
                ]
              }
            },
            "required": [
              "provider",
              "video_id"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Video upscale parameters. Set provider to 'bytedance' or 'topaz'. prompt, count and get_cost are not supported."
      }
    },
    "required": [
      "params"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
