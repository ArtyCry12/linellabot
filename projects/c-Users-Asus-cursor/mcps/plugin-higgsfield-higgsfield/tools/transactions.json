{
  "name": "transactions",
  "description": "List the user's credit transactions (spend/refund/grant/deduct), newest first. Paginated: if next_cursor is not null, pass it as cursor to get the next page.",
  "arguments": {
    "type": "object",
    "properties": {
      "cursor": {
        "description": "Pass next_cursor from the previous response to fetch the next page",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "size": {
        "default": 10,
        "description": "Number of transactions per page (1-100)",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "description": "Credit transactions on this page",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "description": "Model or feature name"
            },
            "credits": {
              "type": "number",
              "description": "Credits charged (negative) or refunded (positive)"
            },
            "action": {
              "type": "string",
              "description": "Transaction type: spend / refund / grant / deduct"
            },
            "created_at": {
              "type": "string",
              "description": "ISO 8601 timestamp"
            }
          },
          "required": [
            "display_name",
            "credits",
            "action",
            "created_at"
          ],
          "additionalProperties": false
        }
      },
      "next_cursor": {
        "description": "Pass as cursor to fetch the next page. Null if no more pages.",
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "type": "string"
      },
      "request_id": {
        "description": "MCP server HTTP request ID for support/debugging. If present, show it to the user.",
        "type": "string"
      },
      "upgrade_url": {
        "description": "Upgrade URL. If present, you MUST show this exact upgrade link to the user so they can upgrade to continue working.",
        "type": "string"
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "plugin": "higgsfield",
  "marketplace": "cursor-public",
  "pluginId": "5420454",
  "marketplaceId": "34"
}