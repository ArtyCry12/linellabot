{
  "name": "create-contact",
  "description": "Create a new contact in Resend. Optionally assign to segments and configure topic subscriptions.",
  "arguments": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "description": "Contact email address"
      },
      "firstName": {
        "description": "Contact first name",
        "type": "string"
      },
      "lastName": {
        "description": "Contact last name",
        "type": "string"
      },
      "unsubscribed": {
        "description": "Whether the contact is unsubscribed from all broadcasts",
        "type": "boolean"
      },
      "properties": {
        "description": "Custom property key-value pairs for the contact (e.g. { \"company_name\": \"Acme\" })",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "segmentIds": {
        "description": "Array of segment IDs to assign this contact to",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "topics": {
        "description": "Array of topic subscription configurations",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Topic ID"
            },
            "subscription": {
              "type": "string",
              "enum": [
                "opt_in",
                "opt_out"
              ],
              "description": "Subscription preference for this topic"
            }
          },
          "required": [
            "id",
            "subscription"
          ]
        }
      }
    },
    "required": [
      "email"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "plugin": "resend",
  "marketplace": "cursor-public",
  "pluginId": "5188",
  "marketplaceId": "34"
}