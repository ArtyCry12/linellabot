{
  "name": "get_help",
  "description": "Get help and usage information for the Gemini MCP server",
  "arguments": {
    "type": "object",
    "properties": {
      "topic": {
        "type": "string",
        "description": "Help topic to get information about",
        "enum": [
          "overview",
          "tools",
          "models",
          "parameters",
          "examples",
          "quick-start"
        ],
        "default": "overview"
      }
    }
  }
}