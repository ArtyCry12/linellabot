                  "type": "object",
                  "properties": {
                    "style_name": {
                      "type": "string",
                      "description": "The name of the style to read variable modes from"
                    },
                    "parent_style_names": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "The parent style names (for combo class)"
                    },
                    "variant_id": {
                      "type": "string",
                      "description": "The component variant id to target. Use 'base' or omit for the base variant."
                    },
                    "breakpoint_id": {
                      "type": "string",
                      "enum": [
                        "main",
                        "small",
                        "medium",
                        "large",
                        "xl",
                        "xxl",
                        "tiny"
                      ],
                      "description": "The breakpoint to get variable modes for"
                    },
                    "pseudo": {
                      "type": "string",
                      "enum": [
                        "noPseudo",
                        "nth-child(odd)",
                        "nth-child(even)",
                        "first-child",
                        "last-child",
                        "hover",
                        "active",
                        "visited",
                        "focus",
                        "focus-visible",
                        "focus-within",
                        "placeholder",
                        "empty",
                        "before",
                        "after"
                      ],
                      "description": "The pseudo class to get variable modes for"
                    }
                  },
                  "required": [
                    "style_name"
                  ],
                  "additionalProperties": false,
                  "description": "Get the variable modes applied to a style. Returns a map of collection IDs to mode IDs. Optionally scoped to a breakpoint or pseudo state."
                }
              },
              "required": [
                "label",
                "get_style_variable_modes"
              ],
              "additionalProperties": false,
              "description": "Run get_style_variable_modes: Get the variable modes applied to a style. Returns a map of collection IDs to mode IDs. Optionally scoped to a breakpoint or pseudo state."
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "#/properties/actions/items/anyOf/0/properties/label"
                },
                "get_styles": {
                  "type": "object",
                  "properties": {
                    "include_properties": {
                      "type": "boolean",
                      "description": "Include style properties in results. Default: false."
                    },
                    "include_breakpoints": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "main",
                          "small",
                          "medium",
                          "large",
                          "xl",
                          "xxl",
                          "tiny"
                        ]
                      },
                      "description": "Breakpoints to include in results. Omit for the base (desktop/main) breakpoint only. Pass an explicit list to opt into additional breakpoints — data intensive."
                    },
                    "include_base_pseudos": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "noPseudo",
                          "nth-child(odd)",
                          "nth-child(even)",
                          "first-child",
                          "last-child",
                          "hover",
                          "active",
                          "visited",
                          "focus",
                          "focus-visible",
                          "focus-within",
                          "placeholder",
                          "empty",
                          "before",
                          "after"
                        ]
                      },
                      "description": "Pseudo states to fetch at the base (no-breakpoint) level. Omit for the base/no-pseudo only."
                    },
                    "include_breakpoints_pseudos": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "noPseudo",
                          "nth-child(odd)",
                          "nth-child(even)",
                          "first-child",
                          "last-child",
                          "hover",
                          "active",
                          "visited",
                          "focus",
                          "focus-visible",
                          "focus-within",
                          "placeholder",
                          "empty",
                          "before",
                          "after"
                        ]
                      },
                      "description": "Pseudo states to fetch inside each breakpoint listed in include_breakpoints. Omit for no per-breakpoint pseudo overrides."
