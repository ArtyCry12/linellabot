{
  "name": "data_style_tool",
  "description": "Data Tool - Style tool to perform actions like get all styles, create a new style, update a style, query styles, remove a style, and manage style variable modes",
  "arguments": {
    "type": "object",
    "properties": {
      "siteId": {
        "type": "string",
        "description": "Unique identifier for the Webflow site (e.g., '580e63e98c9a982ac9b8b741'). Use list_sites to discover available site IDs."
      },
      "pageId": {
        "type": "string",
        "description": "Any valid page id exists in the site"
      },
      "actions": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "description": "Label echoed in the response for this action item. It does not select which action runs."
                },
                "create_style": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The name of the style"
                    },
                    "properties": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "property_name": {
